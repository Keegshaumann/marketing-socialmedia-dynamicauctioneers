{# name: Feature list #}
{# Dynamic ad design AD 2 (D43 / D49), rebuilt to match the real Canva
   "Feature-list" auction ad (DP2995) pixel-for-pixel: 1080x1350, a full-bleed
   darkened property photo behind everything, a metallic-gold MASTER/PROPERTY
   ref bar, the full DS lockup inside a WHITE SHIELD top-left, a gold place +
   descriptor + estate headline, a gold method badge on the right, a
   gold-outlined feature box (one fitting icon per line) on the left, three
   gold-bordered photos stacked on the right, a gold-outlined auction/price box
   bottom-left and a metallic-gold contact bar. Method-aware and DP-ref'd. #}
{% import "_brand.html.j2" as brand %}
{% import "_adparts.html.j2" as parts %}
{% set is_auction = (vm.method == 'auction') %}
{% set stack = ([vm.hero_src] if vm.hero_src else []) + (vm.stack_photos or []) + (vm.gallery_photos or []) %}
{% set feats = (vm.features_main or []) + (vm.features_complex or []) %}
<title>{{ vm.place_line or vm.suburb }} | {{ vm.brand_name }}</title>
<style>
  {{ brand.tokens_css() }}
  :root { --g1:#8a6a38; --g2:#ddc689; --g3:#ac874a; --gline:#ac874a; }
  body { background:#0c0a08; }
  .ig { width:1080px; height:1350px; margin:0 auto; background:#17130E; color:#ffffff;
        position:relative; overflow:hidden; display:flex; flex-direction:column;
        font-family:'Montserrat',system-ui,sans-serif; }

  /* Full-bleed darkened property photo behind the whole ad */
  .fl-bg { position:absolute; inset:0; z-index:0; }
  .fl-bg img { width:100%; height:100%; object-fit:cover; display:block; }
  .fl-bg::after { content:""; position:absolute; inset:0;
        background:linear-gradient(180deg, rgba(10,8,6,.72), rgba(10,8,6,.82)); }
  .fl-bg.plain { background:radial-gradient(120% 80% at 80% 0%, #241d15 0%, #17130E 55%, #100d09 100%); }

  .fl { position:relative; z-index:1; display:flex; flex-direction:column; height:100%; }

  .gold { background:linear-gradient(180deg,#8a6a38 0%,#ac874a 22%,#ddc689 50%,#ac874a 78%,#8a6a38 100%); }

  /* Top ref bar */
  .ig-ref { display:flex; justify-content:space-between; padding:16px 40px; font-size:19px; font-weight:800;
            letter-spacing:.04em; color:#191613; text-transform:uppercase; }

  /* Header: white shield logo + headline */
  .fl-top { display:flex; align-items:flex-start; gap:26px; padding:26px 44px 6px; }
  .shield { flex:none; width:210px; height:236px; background:#fff; display:flex; align-items:center;
            justify-content:center; padding:20px 24px 58px;
            clip-path:path('M8,0 H202 Q210,0 210,8 V150 Q210,196 105,236 Q0,196 0,150 V8 Q0,0 8,0 Z'); }
  .shield img { width:100%; height:auto; display:block; }
  .fl-head { flex:1; min-width:0; padding-top:8px; }
  .fl-place { margin:0; font-size:70px; font-weight:900; line-height:.95; color:var(--g2);
              text-transform:uppercase; letter-spacing:-.01em; text-shadow:0 3px 10px rgba(0,0,0,.55); }
  .fl-desc  { margin:2px 0 0; font-size:52px; font-weight:900; line-height:.98; color:#fff;
              text-transform:uppercase; letter-spacing:-.01em; text-shadow:0 2px 8px rgba(0,0,0,.55); }
  .fl-estate{ margin:8px 0 0; font-size:27px; font-weight:800; line-height:1; color:#fff;
              text-transform:uppercase; letter-spacing:.02em; }

  /* Method badge, right-aligned */
  .fl-badge-row { display:flex; justify-content:flex-end; padding:10px 44px 0; }
  .ig-badge { display:inline-block; padding:12px 30px; font-size:30px; font-weight:900;
              letter-spacing:.02em; text-transform:uppercase; color:#191613; border-radius:8px;
              box-shadow:0 4px 14px rgba(0,0,0,.4); }

  /* Two-column body fills the space between header and contact bar */
  .fl-body { flex:1 1 auto; min-height:0; display:grid; grid-template-columns:1.18fr .88fr;
             gap:20px; padding:16px 44px 8px; }
  .fl-left  { display:flex; flex-direction:column; gap:16px; min-height:0; min-width:0; }
  .fl-right { display:flex; flex-direction:column; gap:14px; min-height:0; min-width:0; }

  .fl-featbox { flex:1 1 auto; min-height:0; min-width:0; border:2.5px solid var(--gline); border-radius:20px;
                background:rgba(14,11,8,.42); padding:22px 30px; display:flex; flex-direction:column;
                justify-content:space-around; }
  .fl-item { display:flex; align-items:center; gap:16px; font-size:25px; font-weight:800; color:#fff;
             text-transform:uppercase; letter-spacing:0; line-height:1.02; min-width:0; }
  .fl-item span { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; min-width:0; }
  .fl-item svg { width:44px; height:44px; stroke:#fff; fill:none; stroke-width:1.5;
                 stroke-linecap:round; stroke-linejoin:round; flex:none; }

  .fl-photos { flex:1 1 auto; min-height:0; display:grid; grid-template-rows:repeat(3,1fr); gap:14px; }
  .fl-photos img { width:100%; height:100%; object-fit:cover; display:block; min-height:0;
                   border:3px solid var(--gline); border-radius:12px; }

  .fl-moneybox { flex:none; border:2.5px solid var(--gline); border-radius:16px;
                 background:rgba(14,11,8,.42); padding:20px 26px; text-align:center; }
  .fl-money-l { font-size:40px; font-weight:900; color:#fff; text-transform:uppercase; line-height:1.02; letter-spacing:.01em; }
  .fl-money-s { margin-top:4px; font-size:38px; font-weight:900; color:var(--g2); text-transform:uppercase; line-height:1.02; }

  /* Contact bar */
  .ig-contact { padding:20px 44px; display:flex; align-items:center; justify-content:space-between; gap:24px; font-size:24px; font-weight:800; color:#191613; }
  .ig-contact span { display:flex; align-items:center; gap:14px; }
  .ig-contact .dot { width:38px; height:38px; border-radius:50%; background:#191613; display:flex; align-items:center; justify-content:center; flex:none; }
  .ig-contact .dot svg { width:20px; height:20px; fill:#ddc689; }
  .ig-contact svg.mail { width:30px; height:24px; fill:none; stroke:#191613; stroke-width:1.8; }
  .nb{white-space:nowrap}
</style>

<div class="ig ad">
  <div class="fl-bg{{ '' if vm.hero_src else ' plain' }}">
    {% if vm.hero_src %}<img src="{{ vm.hero_src }}" alt=""/>{% endif %}
  </div>

  <div class="fl">
    <div class="ig-ref gold">
      <span>{% if vm.public_ref %}MASTER REF: {{ vm.public_ref }}{% endif %}</span>
      <span>PROPERTY REF: {{ vm.property_ref }}</span>
    </div>

    <div class="fl-top">
      <div class="shield">{{ parts.brand_logo(vm, 'light') }}</div>
      <div class="fl-head">
        {% if vm.place_line %}<h1 class="fl-place">{{ vm.place_line }}</h1>{% endif %}
        {% if vm.descriptor_line %}<div class="fl-desc">{{ vm.descriptor_line }}</div>{% endif %}
        {% if vm.scheme %}<div class="fl-estate">In {{ vm.scheme }}</div>{% endif %}
      </div>
    </div>

    <div class="fl-badge-row">
      <span class="ig-badge gold">{{ parts.badge_text(vm) }}</span>
    </div>

    <div class="fl-body">
      <div class="fl-left">
        <div class="fl-featbox">
          {% if vm.size_str %}<div class="fl-item">{{ parts.icon_size() }}<span><span class="nb">&plusmn;{{ vm.size_str }}m&sup2;</span> Property</span></div>{% endif %}
          {% if vm.beds %}<div class="fl-item">{{ parts.icon_bed() }}<span>{{ vm.beds }} Bedroom{{ 's' if vm.beds != '1' }}</span></div>{% endif %}
          {% if vm.baths %}<div class="fl-item">{{ parts.icon_bath() }}<span>{{ vm.baths }} Bathroom{{ 's' if vm.baths != '1' }}</span></div>{% endif %}
          {% if vm.garages and vm.garages != '0' %}<div class="fl-item">{{ parts.icon_garage() }}<span>{{ parts.garage_word(vm.garages) }}</span></div>{% endif %}
          {% for f in feats[:4] %}<div class="fl-item">{{ parts.feature_icon(f) }}<span>{{ f }}</span></div>{% endfor %}
        </div>

        <div class="fl-moneybox">
          {% if is_auction %}
            <div class="fl-money-l">{{ (vm.auction_channel or 'Online') | upper }} Auction</div>
            <div class="fl-money-s">{% if vm.auction_date %}{{ vm.auction_date | upper }}{% endif %}{% if vm.auction_time %} | {{ vm.auction_time }}{% endif %}</div>
          {% else %}
            <div class="fl-money-l">{{ vm.price_display or 'Offers Invited' }}</div>
          {% endif %}
        </div>
      </div>

      <div class="fl-right">
        {% if stack %}
        <div class="fl-photos">
          {% for src in stack[:3] %}<img src="{{ src }}" alt="Property photo"/>{% endfor %}
        </div>
        {% endif %}
      </div>
    </div>

    <div class="ig-contact gold">
      <span><span class="dot"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.4.55 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.3a1 1 0 0 1 1 1 11 11 0 0 0 .55 3.4 1 1 0 0 1-.24 1z"/></svg></span>{{ vm.brand_phone }}</span>
      <span><svg class="mail" viewBox="0 0 24 24"><path d="M3 5h18v14H3z"/><path d="M3 6l9 6 9-6"/></svg>{{ vm.brand_email }}</span>
    </div>
  </div>
</div>
