{# name: Feature list #}
{# Dynamic ad design AD 2 (D43), rebuilt from the real "Feature-list" ads
   (DP2853, DP2962.2): 1080x1350 dark canvas, gold chrome, logo top-left in a
   white shield, place + descriptor headline top-right, method-aware badge, a
   "PROPERTY FEATURES:" icon bullet list on the left with an address pill, three
   stacked photos on the right, a price/auction bar, terms strip and contact bar.
   Method-aware and DP-ref'd like the rest of the library. #}
{% import "_brand.html.j2" as brand %}
{% import "_adparts.html.j2" as parts %}
{% set is_auction = (vm.method == 'auction') %}
{% set photos = ([vm.hero_src] if vm.hero_src else []) + (vm.stack_photos or []) + (vm.gallery_photos or []) %}
{% set feats = (vm.features_main or []) + (vm.features_complex or []) %}
<title>{{ vm.place_line or vm.suburb }} | {{ vm.brand_name }}</title>
<style>
  {{ brand.tokens_css() }}
  :root { --g1:#8C6D33; --g2:#E8CE92; --g3:#B08D4A; }
  body { background:#0c0a08; }
  .ig { width:1080px; height:1350px; margin:0 auto; background:#17130E; color:#F2ECE0; position:relative; overflow:hidden;
        display:flex; flex-direction:column;
        background-image:radial-gradient(120% 80% at 80% 0%, #241d15 0%, #17130E 55%, #100d09 100%); }
  .gold { background:linear-gradient(120deg,var(--g1),var(--g2) 42%,var(--g3) 70%,var(--g1)); }
  .ig-ref { display:flex; justify-content:space-between; padding:14px 40px; font-size:16px; font-weight:800;
            letter-spacing:.06em; color:#1c1811; text-transform:uppercase; }
  .fl-top { display:flex; align-items:center; gap:22px; padding:30px 40px 8px; }
  .fl-logo { background:#fff; border-radius:10px; padding:14px 18px; flex:none; width:210px; }
  .fl-logo img { width:100%; display:block; }
  .fl-head { flex:1; min-width:0; }
  .fl-place { margin:0; font-size:44px; font-weight:800; line-height:1.02; color:var(--g2); text-transform:uppercase; letter-spacing:-.01em; }
  .fl-desc { margin:2px 0 0; font-size:40px; font-weight:800; line-height:1.02; color:#fff; text-transform:uppercase; letter-spacing:-.01em; }
  .ig-badge { display:inline-block; margin:14px 40px 0; padding:10px 22px; font-size:24px; font-weight:800;
              letter-spacing:.04em; text-transform:uppercase; color:#1c1811; }
  .fl-body { display:grid; grid-template-columns:1.15fr 1fr; gap:18px; padding:18px 40px 6px; align-items:start; }
  .fl-feat-h { font-size:34px; font-weight:800; color:var(--g2); text-transform:uppercase; letter-spacing:.02em; margin:0 0 14px; }
  .fl-list { display:flex; flex-direction:column; gap:16px; }
  .fl-item { display:flex; align-items:center; gap:16px; font-size:26px; font-weight:800; color:#fff; text-transform:uppercase; letter-spacing:.01em; line-height:1.05; }
  .fl-item svg { width:44px; height:44px; stroke:#fff; fill:none; stroke-width:1.6; flex:none; }
  .fl-item.feat svg { stroke:var(--g2); }
  .fl-pin { display:inline-flex; align-items:center; gap:12px; margin-top:20px; border:2px solid var(--g3);
            border-radius:999px; padding:12px 22px; font-size:22px; font-weight:800; color:#fff; text-transform:uppercase; }
  .fl-pin svg { width:26px; height:26px; fill:var(--g2); }
  .fl-photos { display:grid; grid-template-rows:repeat(3,1fr); gap:12px; height:640px; }
  .fl-photos img { width:100%; height:100%; object-fit:cover; display:block; border-radius:6px; min-height:0; }
  .ig-money { margin:6px 40px 0; border:2px solid var(--g3); border-radius:10px; padding:16px 14px; text-align:center;
              font-weight:800; color:#fff; text-transform:uppercase; }
  .ig-money.price { font-size:44px; }
  .ig-money.auction { font-size:34px; }
  .ig-terms { margin:12px 40px 0; border:1.5px solid var(--g3); border-radius:999px; padding:12px 20px; text-align:center;
              font-size:17px; font-weight:800; letter-spacing:.04em; color:#e9dcc0; text-transform:uppercase; }
  .ig-contact { margin-top:auto; padding:18px 40px; display:flex; align-items:center; gap:40px; font-size:22px; font-weight:800; color:#1c1811; }
  .ig-contact span { display:flex; align-items:center; gap:12px; }
  .ig-contact svg { width:26px; height:26px; fill:#1c1811; }
</style>

<div class="ig ad">
  <div class="ig-ref gold">
    <span>{% if vm.public_ref %}MASTER REF: {{ vm.public_ref }}{% endif %}</span>
    <span>PROPERTY REF: {{ vm.property_ref }}</span>
  </div>

  <div class="fl-top">
    <div class="fl-logo">{{ parts.brand_logo(vm, 'light') }}</div>
    <div class="fl-head">
      {% if vm.place_line %}<h1 class="fl-place">{{ vm.place_line }}</h1>{% endif %}
      {% if vm.descriptor_line %}<div class="fl-desc">{{ vm.descriptor_line }}</div>{% endif %}
    </div>
  </div>
  <span class="ig-badge gold">{{ parts.badge_text(vm) }}</span>

  <div class="fl-body">
    <div>
      <div class="fl-feat-h">Property Features:</div>
      <div class="fl-list">
        {% if vm.size_str %}<div class="fl-item">{{ parts.icon_size() }}<span>&plusmn;{{ vm.size_str }}m&sup2; Property</span></div>{% endif %}
        {% if vm.beds %}<div class="fl-item">{{ parts.icon_bed() }}<span>{{ vm.beds }} Bedroom{{ 's' if vm.beds != '1' }}</span></div>{% endif %}
        {% if vm.baths %}<div class="fl-item">{{ parts.icon_bath() }}<span>{{ vm.baths }} Bathroom{{ 's' if vm.baths != '1' }}</span></div>{% endif %}
        {% if vm.garages and vm.garages != '0' %}<div class="fl-item">{{ parts.icon_garage() }}<span>{{ vm.garages }} Garage{{ 's' if vm.garages != '1' }}</span></div>{% endif %}
        {% for f in feats[:3] %}<div class="fl-item feat">{{ parts.icon_feature() }}<span>{{ f }}</span></div>{% endfor %}
      </div>
      {% set pin = vm.scheme or vm.address or vm.suburb %}
      {% if pin %}<div class="fl-pin"><svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>{{ pin }}</div>{% endif %}
    </div>
    {% if photos %}
    <div class="fl-photos">
      {% for src in photos[:3] %}<img src="{{ src }}" alt="Property photo"/>{% endfor %}
    </div>
    {% endif %}
  </div>

  <div class="ig-money {{ 'auction' if is_auction else 'price' }}">{{ parts.money_text(vm) }}</div>

  {% if vm.terms %}<div class="ig-terms">{{ vm.terms | join('  |  ') }}</div>{% endif %}

  <div class="ig-contact gold">
    <span><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.4.55 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.3a1 1 0 0 1 1 1 11 11 0 0 0 .55 3.4 1 1 0 0 1-.24 1z"/></svg>{{ vm.brand_phone }}</span>
    <span><svg viewBox="0 0 24 24"><path d="M3 5h18v14H3z" fill="none" stroke="#1c1811" stroke-width="1.6"/><path d="M3 6l9 6 9-6" fill="none" stroke="#1c1811" stroke-width="1.6"/></svg>{{ vm.brand_email }}</span>
  </div>
</div>
