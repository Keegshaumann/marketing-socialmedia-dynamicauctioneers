{# name: Hero overlay #}
{# Dynamic ad design AD 4 (D45 / D49): a big hero photo with the headline
   overlaid (locality white + scheme/complex gold) and the full DS lockup in a
   white shield top-right, then a descriptor bar, a two-column icon stats grid,
   a gold-outlined price/auction bar, a strip of gold-bordered photos and an
   address pill. Same metallic-gold family chrome as the other designs.
   Method-aware + DP-ref'd. #}
{% import "_brand.html.j2" as brand %}
{% import "_adparts.html.j2" as parts %}
{% set is_auction = (vm.method == 'auction') %}
{% set photos = ([vm.hero_src] if vm.hero_src else []) + (vm.stack_photos or []) + (vm.gallery_photos or []) %}
{% set feats = (vm.features_main or []) + (vm.features_complex or []) %}
<title>{{ vm.place_line or vm.suburb }} | {{ vm.brand_name }}</title>
<style>
  {{ brand.tokens_css() }}
  :root { --g2:#e7d19a; --g3:#b08d4a; --gline:#c9a85f; }
  body { background:#0c0a08; }
  .ig { width:1080px; height:1350px; margin:0 auto; background:#0d0b08; color:#F2ECE0; position:relative; overflow:hidden;
        display:flex; flex-direction:column; font-family:'Montserrat',system-ui,sans-serif; }
  {% if photos %}
  .ig::before { content:''; position:absolute; inset:0; z-index:0;
                background:linear-gradient(180deg, rgba(13,11,8,.86), rgba(13,11,8,.97)), url('{{ photos[0] }}');
                background-size:cover; background-position:center; filter:saturate(.5); }
  {% endif %}
  .ig > * { position:relative; z-index:1; }
  .gold { background:linear-gradient(180deg,#6f5325 0%,#c9a85f 22%,#efdaa6 50%,#c9a85f 78%,#6f5325 100%); }
  .ig-ref { display:flex; justify-content:space-between; padding:16px 40px; font-size:19px; font-weight:800;
            letter-spacing:.04em; color:#1c1811; text-transform:uppercase; }

  .ho-hero { position:relative; height:520px; flex:none; }
  .ho-hero > img { width:100%; height:100%; object-fit:cover; display:block; }
  .ho-logo { position:absolute; top:-8px; right:34px; z-index:2; width:186px; height:210px; background:#fff;
             display:flex; align-items:center; justify-content:center; padding:16px 20px 44px;
             clip-path:path('M8,0 H178 Q186,0 186,8 V133 Q186,174 93,210 Q0,174 0,133 V8 Q0,0 8,0 Z'); }
  .ho-logo img { width:100%; height:auto; display:block; }
  .ho-cap { position:absolute; left:0; right:0; bottom:0; padding:44px 40px 26px;
            background:linear-gradient(to top, rgba(10,8,6,.96), rgba(10,8,6,.15) 78%, transparent); }
  .ho-place { margin:0; font-size:60px; font-weight:900; line-height:.96; color:#fff; text-transform:uppercase; letter-spacing:-.01em; }
  .ho-scheme { margin:2px 0 0; font-size:48px; font-weight:900; line-height:1; color:var(--g2); text-transform:uppercase; letter-spacing:-.01em; }
  .ho-badge { display:inline-block; margin-top:16px; padding:12px 28px; font-size:28px; font-weight:900; letter-spacing:.02em;
              text-transform:uppercase; color:#141210; border-radius:8px; box-shadow:0 4px 14px rgba(0,0,0,.4); }

  .ho-desc { padding:22px 44px 6px; font-size:34px; font-weight:900; color:#fff; text-transform:uppercase; letter-spacing:.01em; line-height:1.04; }
  .ho-stats { flex:1 1 auto; min-height:0; overflow:hidden; display:grid; grid-template-columns:1fr 1fr;
              align-content:center; gap:22px 34px; padding:10px 44px; }
  .ho-item { display:flex; align-items:center; gap:16px; font-size:26px; font-weight:800; color:#fff; text-transform:uppercase; line-height:1.06; }
  .ho-item svg { width:46px; height:46px; stroke:#fff; fill:none; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; flex:none; }

  .ig-money { margin:6px 44px 0; flex:none; border:2.5px solid var(--gline); border-radius:12px; padding:18px 14px; text-align:center;
              font-weight:900; color:#fff; text-transform:uppercase; letter-spacing:.01em; }
  .ig-money.price { font-size:46px; }
  .ig-money.auction { font-size:34px; }

  .ho-strip { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; padding:16px 44px 6px; height:230px; flex:none; }
  .ho-strip img { width:100%; height:100%; object-fit:cover; display:block; border:3px solid var(--gline); border-radius:10px; min-height:0; }

  .ho-addr { margin:6px 44px 0; flex:none; border:2px solid var(--gline); border-radius:999px; padding:12px 22px; display:flex;
             align-items:center; gap:12px; justify-content:center; font-size:21px; font-weight:800; color:#fff; text-transform:uppercase; }
  .ho-addr svg { width:26px; height:26px; fill:var(--g2); flex:none; }

  .ig-contact { margin-top:auto; padding:20px 44px; display:flex; align-items:center; gap:44px; font-size:24px; font-weight:800; color:#141210; }
  .ig-contact span { display:flex; align-items:center; gap:14px; }
  .ig-contact .dot { width:38px; height:38px; border-radius:50%; background:#141210; display:flex; align-items:center; justify-content:center; flex:none; }
  .ig-contact .dot svg { width:20px; height:20px; fill:#efdaa6; }
  .ig-contact svg.mail { width:30px; height:24px; fill:none; stroke:#141210; stroke-width:1.8; }
</style>

<div class="ig ad">
  <div class="ig-ref gold">
    <span>{% if vm.public_ref %}MASTER REF: {{ vm.public_ref }}{% endif %}</span>
    <span>PROPERTY REF: {{ vm.property_ref }}</span>
  </div>

  <div class="ho-hero">
    {% if photos %}<img src="{{ photos[0] }}" alt="{{ vm.place_line or vm.suburb }}"/>{% endif %}
    <div class="ho-logo">{{ parts.brand_logo(vm, 'light') }}</div>
    <div class="ho-cap">
      {% if vm.place_line %}<h1 class="ho-place">{{ vm.place_line }}</h1>{% endif %}
      {% if vm.scheme %}<div class="ho-scheme">{{ vm.scheme }}</div>{% endif %}
      <span class="ho-badge gold">{{ parts.badge_text(vm) }}</span>
    </div>
  </div>

  {% if vm.descriptor_line %}<div class="ho-desc">{{ vm.descriptor_line }}</div>{% endif %}

  <div class="ho-stats">
    {% if vm.size_str %}<div class="ho-item">{{ parts.icon_size() }}<span>&plusmn;{{ vm.size_str }}m&sup2; Property</span></div>{% endif %}
    {% if vm.beds %}<div class="ho-item">{{ parts.icon_bed() }}<span>{{ vm.beds }} Bedroom{{ 's' if vm.beds != '1' }}</span></div>{% endif %}
    {% if vm.baths %}<div class="ho-item">{{ parts.icon_bath() }}<span>{{ vm.baths }} Bathroom{{ 's' if vm.baths != '1' }}</span></div>{% endif %}
    {% if vm.garages and vm.garages != '0' %}<div class="ho-item">{{ parts.icon_garage() }}<span>{{ parts.garage_word(vm.garages) }}</span></div>{% endif %}
    {% for f in feats[:2] %}<div class="ho-item">{{ parts.feature_icon(f) }}<span>{{ f }}</span></div>{% endfor %}
  </div>

  <div class="ig-money {{ 'auction' if is_auction else 'price' }}">{{ parts.money_text(vm) }}</div>

  {% if photos[1:] %}
  <div class="ho-strip">
    {% for src in photos[1:4] %}<img src="{{ src }}" alt="Property photo"/>{% endfor %}
  </div>
  {% endif %}

  {% set addr = vm.address or vm.location_line or vm.suburb %}
  {% if addr %}<div class="ho-addr"><svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>{{ addr }}</div>{% endif %}

  <div class="ig-contact gold">
    <span><span class="dot"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.4.55 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.3a1 1 0 0 1 1 1 11 11 0 0 0 .55 3.4 1 1 0 0 1-.24 1z"/></svg></span>{{ vm.brand_phone }}</span>
    <span><svg class="mail" viewBox="0 0 24 24"><path d="M3 5h18v14H3z"/><path d="M3 6l9 6 9-6"/></svg>{{ vm.brand_email }}</span>
  </div>
</div>
