{# name: Bold Dark #}
{# A dark, full-bleed alternative ad design (D41). Same view model as Classic;
   different look. Self-contained: brand tokens + font from _brand, custom dark
   layout. Fills only what the record supports (no invented facts). #}
{% import "_brand.html.j2" as brand %}
{% import "_adparts.html.j2" as parts %}
<title>{{ vm.headline }} | {{ vm.brand_name }}</title>
<style>
  {{ brand.tokens_css() }}

  body { background: #0E0C0A; }
  .card {
    max-width: 860px; margin: 28px auto 48px; background: var(--ink);
    color: #EDE7DB; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,.5);
  }
  .top { display: flex; justify-content: space-between; align-items: center; padding: 22px 40px; border-bottom: 1px solid rgba(176,141,74,.35); }
  .brand { display: flex; align-items: center; gap: 14px; }
  .brand .mark { font-weight: 800; font-size: 26px; letter-spacing: -.04em; color: #fff; border: 2px solid var(--gold); padding: 2px 9px; line-height: 1; }
  .brand .name { font-size: 17px; font-weight: 800; letter-spacing: .16em; color: #fff; }
  .brand .name b { color: var(--gold); }
  .top .sale { font-size: 11px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: var(--gold); }

  .hero-wrap { position: relative; }
  .hero-wrap img { width: 100%; height: 420px; object-fit: cover; display: block; filter: brightness(.78); }
  .hero-wrap .overlay { position: absolute; left: 0; right: 0; bottom: 0; padding: 40px; background: linear-gradient(to top, rgba(14,12,10,.96), rgba(14,12,10,.15) 70%, transparent); }
  .badge { display: inline-block; background: var(--gold); color: var(--ink); font-weight: 800; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; padding: 8px 16px; margin-bottom: 14px; }
  h1 { font-size: clamp(28px, 5vw, 46px); font-weight: 800; line-height: 1.08; letter-spacing: -.01em; margin: 0; color: #fff; text-wrap: balance; }
  .addr { margin: 10px 0 0; font-size: 14px; color: #C9BFA9; }

  .price { padding: 22px 40px; font-size: 26px; font-weight: 800; color: var(--gold); letter-spacing: .01em; border-bottom: 1px solid rgba(255,255,255,.08); }

  .stats { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; text-align: center; }
  .stats > div { padding: 20px 8px; border-right: 1px solid rgba(255,255,255,.08); }
  .stats > div:last-child { border-right: 0; }
  .stats .n { font-size: 22px; font-weight: 800; color: #fff; font-variant-numeric: tabular-nums; }
  .stats .l { font-size: 10px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #9A9080; margin-top: 4px; }

  .body { padding: 30px 40px; }
  .body h2 { font-size: 12px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--gold); margin: 0 0 12px; }
  .feat { list-style: none; margin: 0 0 22px; padding: 0; columns: 2; column-gap: 34px; }
  .feat li { font-size: 13.5px; line-height: 1.5; padding: 6px 0 6px 18px; position: relative; break-inside: avoid; color: #DDD5C6; }
  .feat li::before { content: ''; position: absolute; left: 0; top: 13px; width: 6px; height: 6px; background: var(--gold); }

  .strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
  .strip img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; }

  .cta { display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap; padding: 24px 40px; background: #17130F; }
  .cta .call { font-size: 12px; color: #9A9080; }
  .cta .num { font-size: 22px; font-weight: 800; color: #fff; }
  .reg { padding: 14px 40px 22px; font-size: 10px; line-height: 1.6; color: #6C6455; }
  @media (max-width: 640px) { .top, .price, .body, .cta, .reg { padding-left: 20px; padding-right: 20px; } .feat { columns: 1; } .stats { grid-auto-flow: row; grid-template-columns: repeat(2, 1fr); } }
</style>

<div class="card">
  <div class="top">
    <div class="brand"><span class="mark">DS</span><span class="name">DYNAMIC <b>{{ 'AUCTIONEERS' if vm.method == 'auction' else 'REAL ESTATE' }}</b></span></div>
    <div class="sale">{{ parts.badge_text(vm) }}</div>
  </div>

  {% if vm.hero_src %}
  <div class="hero-wrap">
    <img src="{{ vm.hero_src }}" alt="{{ vm.headline }}" />
    <div class="overlay">
      <span class="badge">{{ parts.badge_text(vm) }}{% if vm.property_ref %} &middot; Ref {{ vm.property_ref }}{% endif %}</span>
      <h1>{{ vm.headline }}</h1>
      {% if vm.address %}<p class="addr">{{ vm.address }}</p>{% endif %}
    </div>
  </div>
  {% else %}
  <div class="body"><span class="badge">{{ parts.badge_text(vm) }}{% if vm.property_ref %} &middot; Ref {{ vm.property_ref }}{% endif %}</span><h1>{{ vm.headline }}</h1>{% if vm.address %}<p class="addr">{{ vm.address }}</p>{% endif %}</div>
  {% endif %}

  <div class="price">{{ parts.money_text(vm) }}</div>

  <div class="stats">
    {% if vm.size_str %}<div><div class="n">{{ vm.size_str }} m&sup2;</div><div class="l">Extent</div></div>{% endif %}
    {% if vm.beds %}<div><div class="n">{{ vm.beds }}</div><div class="l">Bedrooms</div></div>{% endif %}
    {% if vm.baths %}<div><div class="n">{{ vm.baths }}</div><div class="l">Bathrooms</div></div>{% endif %}
    {% if vm.flatlet_present and vm.flatlet_beds %}<div><div class="n">{{ vm.flatlet_beds }}</div><div class="l">Bed flatlet</div></div>{% endif %}
    {% if vm.title_type_label %}<div><div class="n" style="font-size:15px">{{ vm.title_type_label }}</div><div class="l">Title</div></div>{% endif %}
  </div>

  {% if vm.features_main or vm.features_complex %}
  <div class="body">
    {% if vm.features_main %}<h2>The residence</h2><ul class="feat">{% for f in vm.features_main %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
    {% if vm.features_complex %}<h2>Estate &amp; complex</h2><ul class="feat">{% for f in vm.features_complex %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
  </div>
  {% endif %}

  {% if vm.stack_photos or vm.gallery_photos %}
  <div class="strip">
    {% for src in (vm.stack_photos or []) + (vm.gallery_photos or []) %}<img src="{{ src }}" alt="Property photo" />{% endfor %}
  </div>
  {% endif %}

  <div class="cta">
    <div><div class="call">Enquiries and viewings</div><div class="num">{{ vm.brand_phone }}</div></div>
    <div style="text-align:right"><div class="call">{{ vm.brand_email }}</div><div class="call">{{ vm.brand_web }}</div></div>
  </div>
  <div class="reg">{{ vm.brand_reg }}<br/>{{ vm.generated_note }}</div>
</div>
