{# name: Stats first #}
{# Dynamic ad design AD 3 (D43 / D49), rebuilt to match the real Canva
   "Stats-first" auction ad (DP2988): 1080x1350, a big hero-photo banner across
   the top with the full DS lockup in a WHITE SHIELD overlaid top-right, a
   metallic-gold MASTER/PROPERTY ref strip, a gold place + white descriptor
   headline, a gold method badge with a location pill, a two-column icon stats
   grid (one fitting icon per line), a gold-outlined auction/price bar, a strip
   of three gold-bordered photos and a metallic-gold contact bar. #}
{% import "_brand.html.j2" as brand %}
{% import "_adparts.html.j2" as parts %}
{% set is_auction = (vm.method == 'auction') %}
{% set photos = ([vm.hero_src] if vm.hero_src else []) + (vm.stack_photos or []) + (vm.gallery_photos or []) %}
{% set feats = (vm.features_main or []) + (vm.features_complex or []) %}
<title>{{ vm.place_line or vm.suburb }} | {{ vm.brand_name }}</title>
<style>
  {{ brand.tokens_css() }}
  :root { --g2:#e7d19a; --g3:#b08d4a; --gline:#c9a85f; }
  body { background:#0c0a08; }
  .ig { width:1080px; height:1350px; margin:0 auto; background:#0d0b08; color:#F2ECE0; position:relative; overflow:hidden;
        display:flex; flex-direction:column; font-family:'Montserrat',system-ui,sans-serif; }
  .gold { background:linear-gradient(180deg,#6f5325 0%,#c9a85f 22%,#efdaa6 50%,#c9a85f 78%,#6f5325 100%); }

  .ig-ref { display:flex; justify-content:space-between; padding:16px 40px; font-size:19px; font-weight:800;
            letter-spacing:.04em; color:#1c1811; text-transform:uppercase; }

  .sf-hero { position:relative; height:440px; flex:none; }
  .sf-hero > img { width:100%; height:100%; object-fit:cover; display:block; }
  .sf-hero::after { content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(0,0,0,.05), rgba(13,11,8,.55)); }
  .sf-logo { position:absolute; top:-8px; right:34px; z-index:2; width:190px; height:214px; background:#fff;
             display:flex; align-items:center; justify-content:center; padding:16px 20px 46px;
             clip-path:path('M8,0 H182 Q190,0 190,8 V136 Q190,178 95,214 Q0,178 0,136 V8 Q0,0 8,0 Z'); }
  .sf-logo img { width:100%; height:auto; display:block; }

  .sf-title { padding:24px 40px 4px; }
  .sf-place { margin:0; font-size:58px; font-weight:900; line-height:.96; color:var(--g2); text-transform:uppercase;
              letter-spacing:-.01em; text-shadow:0 2px 8px rgba(0,0,0,.5); }
  .sf-desc  { margin:4px 0 0; font-size:50px; font-weight:900; line-height:.98; color:#fff; text-transform:uppercase; letter-spacing:-.01em; }

  .sf-row { display:flex; align-items:center; gap:18px; padding:16px 40px 4px; flex-wrap:wrap; }
  .ig-badge { display:inline-block; padding:12px 28px; font-size:30px; font-weight:900; letter-spacing:.02em;
              text-transform:uppercase; color:#141210; border-radius:8px; box-shadow:0 4px 14px rgba(0,0,0,.4); }
  .sf-pin { display:inline-flex; align-items:center; gap:12px; border:2px solid var(--gline); border-radius:999px;
            padding:11px 24px; font-size:24px; font-weight:800; color:#fff; text-transform:uppercase; }
  .sf-pin svg { width:26px; height:26px; fill:var(--g2); }

  .sf-stats { flex:1 1 auto; min-height:0; overflow:hidden; display:grid; grid-template-columns:1fr 1fr;
              align-content:center; gap:24px 34px; padding:14px 44px; }
  .sf-item { display:flex; align-items:center; gap:18px; font-size:26px; font-weight:800; color:#fff; text-transform:uppercase; line-height:1.08; }
  .sf-item svg { width:48px; height:48px; stroke:#fff; fill:none; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; flex:none; }

  .ig-money { margin:6px 44px 0; flex:none; border:2.5px solid var(--gline); border-radius:12px; padding:18px 16px; text-align:center;
              font-weight:900; color:#fff; text-transform:uppercase; letter-spacing:.01em; }
  .ig-money.price { font-size:46px; }
  .ig-money.auction { font-size:34px; }

  .sf-strip { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; padding:16px 44px 6px; height:250px; flex:none; }
  .sf-strip img { width:100%; height:100%; object-fit:cover; display:block; border:3px solid var(--gline); border-radius:10px; min-height:0; }

  .ig-contact { margin-top:auto; padding:20px 44px; display:flex; align-items:center; gap:44px; font-size:24px; font-weight:800; color:#141210; }
  .ig-contact span { display:flex; align-items:center; gap:14px; }
  .ig-contact .dot { width:38px; height:38px; border-radius:50%; background:#141210; display:flex; align-items:center; justify-content:center; flex:none; }
  .ig-contact .dot svg { width:20px; height:20px; fill:#efdaa6; }
  .ig-contact svg.mail { width:30px; height:24px; fill:none; stroke:#141210; stroke-width:1.8; }
</style>

<div class="ig ad">
  <div class="ig-ref gold">
    <span>{% if vm.public_ref %}MASTER REF: {{ vm.public_ref }}{% endif %}</span>
    <span>PROPERTY REF: {{ vm.property_ref }}</span>
  </div>

  <div class="sf-hero">
    {% if photos %}<img src="{{ photos[0] }}" alt="{{ vm.place_line or vm.suburb }}"/>{% endif %}
    <div class="sf-logo">{{ parts.brand_logo(vm, 'light') }}</div>
  </div>

  <div class="sf-title">
    {% if vm.place_line %}<h1 class="sf-place">{{ vm.place_line }}</h1>{% endif %}
    {% if vm.descriptor_line %}<div class="sf-desc">{{ vm.descriptor_line }}</div>{% endif %}
  </div>

  <div class="sf-row">
    <span class="ig-badge gold">{{ parts.badge_text(vm) }}</span>
    {% set pin = vm.scheme or vm.address or vm.suburb %}
    {% if pin %}<span class="sf-pin"><svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>{{ pin }}</span>{% endif %}
  </div>

  <div class="sf-stats">
    {% if vm.size_str %}<div class="sf-item">{{ parts.icon_size() }}<span>&plusmn;{{ vm.size_str }}m&sup2; Property</span></div>{% endif %}
    {% if vm.beds %}<div class="sf-item">{{ parts.icon_bed() }}<span>{{ vm.beds }} Bedroom{{ 's' if vm.beds != '1' }}</span></div>{% endif %}
    {% if vm.baths %}<div class="sf-item">{{ parts.icon_bath() }}<span>{{ vm.baths }} Bathroom{{ 's' if vm.baths != '1' }}</span></div>{% endif %}
    {% if vm.garages and vm.garages != '0' %}<div class="sf-item">{{ parts.icon_garage() }}<span>{{ parts.garage_word(vm.garages) }}</span></div>{% endif %}
    {% for f in feats[:2] %}<div class="sf-item">{{ parts.feature_icon(f) }}<span>{{ f }}</span></div>{% endfor %}
  </div>

  <div class="ig-money {{ 'auction' if is_auction else 'price' }}">{{ parts.money_text(vm) }}</div>

  {% if photos[1:] %}
  <div class="sf-strip">
    {% for src in photos[1:4] %}<img src="{{ src }}" alt="Property photo"/>{% endfor %}
  </div>
  {% endif %}

  <div class="ig-contact gold">
    <span><span class="dot"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.4.55 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.3a1 1 0 0 1 1 1 11 11 0 0 0 .55 3.4 1 1 0 0 1-.24 1z"/></svg></span>{{ vm.brand_phone }}</span>
    <span><svg class="mail" viewBox="0 0 24 24"><path d="M3 5h18v14H3z"/><path d="M3 6l9 6 9-6"/></svg>{{ vm.brand_email }}</span>
  </div>
</div>
