{# name: Collage #}
{# Dynamic Auctioneers / Real Estate flagship social ad (D41), rebuilt from the
   real "AD 1" design: 1080x1350 dark canvas, gold chrome, stacked gold-accent
   headline, 1-big-plus-3 photo collage, price/auction bar, gold stat pill.
   Method-aware: For Sale vs Auction swaps the badge, brand and price block.
   Every value fills from the view model; the DP shows as PROPERTY REF (D42). #}
{% import "_brand.html.j2" as brand %}
{% import "_adparts.html.j2" as parts %}
{% set is_auction = (vm.method == 'auction') %}
{% set hl = (vm.headline or '') | split3 %}
{# The marketer's pick for the adverts when she has made one (D90),
   otherwise the lead plus the gallery, exactly as before. #}
{% set photos = vm.ad_photos or (([vm.hero_src] if vm.hero_src else []) + (vm.stack_photos or []) + (vm.gallery_photos or [])) %}
{# Brand by sale method: Auction -> Dynamic Auctioneers, everything else ->
   Dynamic Real Estate (the estate-agency department). Dark-bg (white) logo,
   since the header sits on the dark canvas. #}
{# The shield is white, so the logo on it is the ON-LIGHT artwork. #}
{% set logo = asset_uri('ads/_assets/logo-' ~ ('auctioneers' if is_auction else 'realestate') ~ '-on-light.png') %}
<title>{{ vm.headline }} | {{ vm.brand_name }}</title>
<style>
  {{ brand.tokens_css() }}
  :root { --g1:#8a6a38; --g2:#ddc689; --g3:#ac874a; --gline:#ac874a; }
  body { background:#0c0a08; }
  .ig {
    width:1080px; height:1350px; margin:0 auto; background:#17130E; color:#ffffff;
    position:relative; overflow:hidden; display:flex; flex-direction:column;
    font-family:'Montserrat',system-ui,sans-serif;
    background-image:radial-gradient(120% 80% at 80% 0%, #241d15 0%, #17130E 55%, #100d09 100%);
  }
  .gold { background:linear-gradient(180deg,#8a6a38 0%,#ac874a 22%,#ddc689 50%,#ac874a 78%,#8a6a38 100%); }
  .ig-ref { display:flex; justify-content:space-between; padding:16px 40px; font-size:19px; font-weight:800;
            letter-spacing:.04em; color:#191613; text-transform:uppercase; }
  .ig-top { display:flex; align-items:flex-start; gap:24px; padding:34px 40px 10px; }
  .ig-head { flex:1; min-width:0; }
  h1 { margin:0; font-size:56px; line-height:1.02; font-weight:800; letter-spacing:-.01em; color:#fff; text-transform:uppercase; }
  h1 .em { color:var(--g2); }
  .ig-badge { display:inline-block; margin-top:16px; padding:10px 22px; font-size:22px; font-weight:800;
              letter-spacing:.04em; text-transform:uppercase; color:#191613; }
  /* The white shield lockup, as every reference ad carries it (not a bare
     logo on the dark ground). drop-shadow rather than box-shadow: clip-path
     discards a box-shadow, which is drawn outside the clip (D78). */
  .ig-logo { flex:none; width:200px; height:225px; background:#fff; display:flex; align-items:center;
             justify-content:center; padding:18px 22px 54px;
             filter:drop-shadow(0 10px 18px rgba(0,0,0,.42));
             clip-path:path('M8,0 H192 Q200,0 200,8 V143 Q200,187 100,225 Q0,187 0,143 V8 Q0,0 8,0 Z'); }
  .ig-logo img { width:100%; height:auto; display:block; }

  /* 560px is the PREFERRED height, not a fixed one. ``min-height:0`` is what
     lets it give way: a flex item defaults to ``min-height:auto``, which for a
     grid container resolves to its content's min-content height, so the block
     refused to shrink and a long terms strip pushed the gold contact bar off a
     canvas that is ``overflow:hidden`` - measured at 1379px on a 1350px canvas,
     which sliced the phone number and email in half (D83). Losing a few pixels
     of photograph is nothing; losing the number a buyer rings is the ad. */
  /* `flex:1 1 auto` in BOTH directions: it grows into whatever the rest of the
     column leaves over, so the ad fills its canvas the way the reference ads do
     rather than ending in a band of dead space above the footer, and it still
     gives way when the content is long (D83/D84). */
  .ig-collage { display:grid; grid-template-columns:1.55fr 1fr; gap:12px; padding:16px 40px;
                height:560px; min-height:0; flex:1 1 auto; }
  .ig-collage .hero { width:100%; height:100%; object-fit:cover; display:block; border:3px solid var(--gline); border-radius:10px; }
  .ig-collage .col { display:grid; grid-template-rows:repeat(3,1fr); gap:12px; min-height:0; }
  .ig-collage .col img { width:100%; height:100%; object-fit:cover; display:block; border:3px solid var(--gline); border-radius:10px; min-height:0; }

  .ig-price { margin:14px 40px 0; border:2px solid var(--g3); border-radius:10px; padding:16px;
              text-align:center; font-size:52px; font-weight:900; color:#fff; letter-spacing:.01em;
              text-transform:uppercase; }
  .ig-price small { display:block; font-size:20px; font-weight:800; letter-spacing:.14em; color:var(--g2); }
  .ig-auction { margin:14px 40px 0; border:2px solid var(--g3); border-radius:10px; padding:16px 14px;
                text-align:center; font-size:34px; font-weight:800; color:#fff; letter-spacing:.01em; text-transform:uppercase; }
  /* A bottom margin so the strip breathes above the gold footer instead of
     sitting on it. Free: the collage grows to fill whatever is left over, so
     this costs photo height, not overflow. */
  .ig-terms { margin:12px 40px 16px; border:1.5px solid var(--g3); border-radius:999px; padding:12px 20px;
              text-align:center; font-size:17px; font-weight:800; letter-spacing:.04em; color:#e9dcc0; text-transform:uppercase;
              overflow-wrap:anywhere; }
  .ig-tag { padding:18px 40px 6px; text-align:center; font-size:23px; font-weight:800; letter-spacing:.02em;
            color:#fff; text-transform:uppercase; overflow-wrap:anywhere; }
  .ig-stats { margin:8px 40px 0; border:2px solid var(--g3); border-radius:999px; display:flex;
              align-items:center; justify-content:space-around; gap:8px; padding:16px 10px; }
  .ig-stat { display:flex; align-items:center; gap:10px; font-size:24px; font-weight:800; color:#fff; letter-spacing:.02em; }
  .ig-stat svg { width:34px; height:34px; stroke:#fff; fill:none; stroke-width:1.7; flex:none; }
  .ig-stat .u { font-size:15px; font-weight:700; color:#d9cfb8; letter-spacing:.12em; text-transform:uppercase; }
  .ig-contact { margin-top:auto; padding:20px 40px; display:flex; align-items:center; justify-content:space-between; gap:24px;
                font-size:24px; font-weight:800; color:#191613; }
  .ig-contact span { display:flex; align-items:center; gap:14px; }
  .ig-contact .dot { width:38px; height:38px; border-radius:50%; background:#191613; display:flex; align-items:center; justify-content:center; flex:none; }
  .ig-contact .dot svg { width:20px; height:20px; fill:#ddc689; }
  .ig-contact svg.mail { width:30px; height:24px; fill:none; stroke:#191613; stroke-width:1.8; }
  .nb{white-space:nowrap}
  .un{text-transform:none}
</style>

<div class="ig ad">
  <div class="ig-ref gold">
    <span>{% if vm.public_ref %}MASTER REF: {{ vm.public_ref }}{% endif %}</span>
    <span>PROPERTY REF: {{ vm.property_ref }}</span>
  </div>

  <div class="ig-top">
    <div class="ig-head">
      <h1>{% for line in hl %}<span class="{{ 'em' if loop.index == 2 and hl|length == 3 else '' }}">{{ line }}</span>{% if not loop.last %}<br/>{% endif %}{% endfor %}</h1>
      <span class="ig-badge gold">{{ parts.badge_text(vm) }}</span>
    </div>
    <div class="ig-logo"><img src="{{ logo }}" alt="{{ vm.brand_name }}"/></div>
  </div>

  {% if photos %}
  <div class="ig-collage">
    <img class="hero" src="{{ photos[0] }}" alt="{{ vm.headline }}"/>
    <div class="col">
      {% for src in photos[1:4] %}<img src="{{ src }}" alt="Property photo"/>{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if is_auction %}
  <div class="ig-auction">{{ (vm.auction_channel or 'Online') | upper }} AUCTION{% if vm.auction_date %} | {{ vm.auction_date | upper }}{% endif %}{% if vm.auction_time %} @ {{ vm.auction_time }}{% endif %}</div>
  {% else %}
  <div class="ig-price">{{ vm.price_display or 'Offers invited' }}</div>
  {% endif %}

  {# The reference ads' short strip: three punchy phrases, not three sentences. #}
  {% if vm.tagline %}
  <div class="ig-tag">{{ vm.tagline | join('  |  ') }}</div>
  {% endif %}

  <div class="ig-stats">
    {% if vm.beds %}<div class="ig-stat">{{ parts.stat_icon('bedrooms', vm) }}{{ vm.beds }} <span class="u">Bed</span></div>{% endif %}
    {% if vm.baths %}<div class="ig-stat">{{ parts.stat_icon('bathrooms', vm) }}{{ vm.baths }} <span class="u">Bath</span></div>{% endif %}
    {% if vm.garages and vm.garages != '0' %}<div class="ig-stat">{{ parts.stat_icon('garages', vm) }}{{ vm.garages }} <span class="u">Garage{{ 's' if vm.garages != '1' }}</span></div>{% endif %}
    {% if vm.size_str %}<div class="ig-stat nb">{% if vm.size_ha %}{{ vm.size_ha }}<span class="u un" style="font-size:19px"> ha</span>{% else %}{{ vm.size_str }}<span class="u un" style="font-size:19px">m&sup2;</span>{% endif %}</div>{% endif %}
  </div>

  {% if vm.terms %}
  <div class="ig-terms">{{ vm.terms | join('  |  ') }}</div>
  {% endif %}

  <div class="ig-contact gold">
    <span><span class="dot"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.4.55 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.3a1 1 0 0 1 1 1 11 11 0 0 0 .55 3.4 1 1 0 0 1-.24 1z"/></svg></span>{{ vm.brand_phone }}</span>
    <span><svg class="mail" viewBox="0 0 24 24"><path d="M3 5h18v14H3z"/><path d="M3 6l9 6 9-6"/></svg>{{ vm.brand_email }}</span>
  </div>
</div>
