{# Buyer / auction information pack (SPEC 12 step 6c), built to the Info Pack
   Playbook (docs/INFO-PACK-PLAYBOOK.md). Rendered from public_view only, so the
   owner name/ID never appear (SPEC 4.4).

   Auction vs sale is the key branch (playbook 5): the pack only uses auction /
   bidding language when sale_process.method == "auction". A normal listing is an
   "Information pack" using offer / expression-of-interest language ("How to
   proceed", "Submit an offer", "conditions of sale"), never auction / bid words.
   Figures are hedged (approx.) and both disclaimers appear verbatim (playbook 8). #}
{% import "_brand.html.j2" as brand %}
{% set is_auction = (vm.method == 'auction') %}
<title>{{ 'Auction information pack' if is_auction else 'Information pack' }} {{ vm.headline }} | {{ vm.brand_name }}</title>
<style>
  {{ brand.tokens_css() }}
  .sheet { max-width: 820px; margin: 24px auto 48px; background: var(--sheet); box-shadow: 0 2px 6px rgba(25,22,19,.08), 0 18px 44px rgba(25,22,19,.13); }
  .inner { padding: 34px 44px 44px; }
  .kicker { font-size: 11px; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; color: var(--gold-deep); }
  h1 { font-size: 32px; font-weight: 800; line-height: 1.14; color: var(--ink); margin: 12px 0 6px; }
  .addr { font-size: 15px; color: var(--muted); margin: 0 0 20px; }
  h2 { font-size: 13px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--ink); margin: 30px 0 12px; padding-bottom: 8px; border-bottom: 2px solid var(--gold); display: inline-block; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { font-size: 14px; line-height: 1.5; padding: 7px 0 7px 20px; position: relative; border-bottom: 1px solid var(--hairline); }
  li:last-child { border-bottom: 0; }
  li::before { content: ''; position: absolute; left: 2px; top: 15px; width: 7px; height: 7px; background: var(--gold); }
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 2px solid var(--ink); border-bottom: 1px solid var(--hairline); margin: 18px 0 6px; }
  .facts > div { padding: 14px 8px; text-align: center; border-right: 1px solid var(--hairline); }
  .facts > div:last-child { border-right: 0; }
  .facts .n { font-size: 20px; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
  .facts .l { font-size: 10px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-top: 4px; }
  .kv { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .kv td { padding: 9px 0; border-bottom: 1px solid var(--hairline); vertical-align: top; }
  .kv td:first-child { color: var(--muted); font-weight: 600; width: 42%; }
  .kv td:last-child { color: var(--ink); font-variant-numeric: tabular-nums; }
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 16px; }
  .gallery img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; }
  /* The "how it is offered" callout: auction line or offers-invited. */
  .optbox { margin: 22px 0 6px; border: 1px solid var(--hairline); border-left: 4px solid var(--gold); background: var(--gold-pale); padding: 16px 20px; }
  .optbox .ey { font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--gold-deep); }
  .optbox .big { font-size: 19px; font-weight: 800; color: var(--ink); margin-top: 4px; }
  .optbox .sub { font-size: 13px; color: var(--body); margin-top: 3px; }
  /* Numbered "how to proceed" / "how the auction works" steps. */
  ol.steps { list-style: none; counter-reset: s; margin: 0; padding: 0; }
  ol.steps li { counter-increment: s; padding: 8px 0 8px 34px; }
  ol.steps li::before { content: counter(s); top: 8px; left: 0; width: 20px; height: 20px; border-radius: 50%; background: var(--ink); color: #fff; font-size: 11px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .note { font-size: 12px; color: var(--muted); line-height: 1.6; margin: 10px 0 0; }
  .disc { font-size: 10.5px; color: var(--muted); line-height: 1.65; margin: 8px 0 0; }
  .disc strong { color: var(--body); }
  @media (max-width: 640px) { .inner { padding: 24px 20px 32px; } .grid { grid-template-columns: 1fr; } .facts { grid-template-columns: repeat(2, 1fr); } }
  @media print { body { background: #fff; } .sheet { margin: 0; box-shadow: none; max-width: none; } }
</style>

<div class="sheet">
  {{ brand.letterhead(vm) }}
  <div class="inner">
    <div class="kicker">{{ 'Auction information pack' if is_auction else 'Buyer information pack' }}{% if vm.public_ref %} | {{ vm.public_ref }}{% endif %}</div>
    <h1>{{ vm.headline }}</h1>
    {% if vm.address %}<p class="addr">{{ vm.address }}</p>{% endif %}

    {% if vm.hero_src %}<img src="{{ vm.hero_src }}" alt="{{ vm.headline }}" style="width:100%;height:auto;display:block" />{% endif %}

    {# How it is offered: auction specifics, or offers invited. Never mix. #}
    <div class="optbox">
      {% if is_auction %}
        <div class="ey">On auction</div>
        <div class="big">{% if vm.auction_type %}{{ vm.auction_type }} auction{% else %}Auction{% endif %}</div>
        <div class="sub">
          {%- set bits = [] -%}
          {%- if vm.auction_channel %}{% set _ = bits.append(vm.auction_channel) %}{% endif -%}
          {%- if vm.auction_date %}{% set _ = bits.append(vm.auction_date) %}{% endif -%}
          {%- if bits %}{{ bits | join(', ') }}{% if vm.auction_time %} at {{ vm.auction_time }}{% endif %}{% else %}Auction date to be confirmed{% endif -%}
        </div>
      {% else %}
        <div class="ey">How it is offered</div>
        <div class="big">{{ vm.price_display or 'Offers invited' }}</div>
        <div class="sub">Written offers invited, subject to the conditions of sale and the seller's confirmation.</div>
      {% endif %}
    </div>

    <div class="facts">
      {% if vm.size_str %}<div><div class="n">{{ vm.size_str }} m2</div><div class="l">Approx. size</div></div>{% endif %}
      {% if vm.beds %}<div><div class="n">{{ vm.beds }}</div><div class="l">Bedrooms</div></div>{% endif %}
      {% if vm.baths %}<div><div class="n">{{ vm.baths }}</div><div class="l">Bathrooms</div></div>{% endif %}
      {% if vm.flatlet_present and vm.flatlet_beds %}<div><div class="n">{{ vm.flatlet_beds }}</div><div class="l">Bed flatlet</div></div>{% endif %}
    </div>

    <div class="grid">
      {% if vm.features_main %}<div><h2>Main residence</h2><ul>{% for f in vm.features_main %}<li>{{ f }}</li>{% endfor %}</ul></div>{% endif %}
      {% if vm.features_complex %}<div><h2>Flatlet and complex</h2><ul>{% for f in vm.features_complex %}<li>{{ f }}</li>{% endfor %}</ul></div>{% endif %}
    </div>

    <h2>Property details</h2>
    <table class="kv">
      {% if vm.public_ref %}<tr><td>Reference</td><td>{{ vm.public_ref }}</td></tr>{% endif %}
      {% if vm.title_type_label %}<tr><td>Title type</td><td>{{ vm.title_type_label }}</td></tr>{% endif %}
      {% if vm.scheme %}<tr><td>Scheme</td><td>{{ vm.scheme }}{% if vm.unit %}, unit {{ vm.unit }}{% endif %}</td></tr>{% endif %}
      {% if vm.erf %}<tr><td>Erf</td><td>{{ vm.erf }}</td></tr>{% endif %}
      {% if vm.size_str %}<tr><td>Extent</td><td>approx. {{ vm.size_str }} m2</td></tr>{% endif %}
      {% if vm.zoning %}<tr><td>Zoning</td><td>{{ vm.zoning }}</td></tr>{% endif %}
      {% if vm.municipality %}<tr><td>Municipality</td><td>{{ vm.municipality }}</td></tr>{% endif %}
      {# Municipal valuation is never shown to buyers - the money element is
         always the offers framing, never a valuation figure (owner directive). #}
      <tr><td>Method of sale</td><td>{{ 'Auction' if is_auction else 'Offers invited' }}</td></tr>
    </table>
    <p class="note">All extents, figures and features are approximate, drawn from public deeds and third-party records, and to be confirmed on due diligence.</p>

    {% if vm.terms %}
    <h2>Conditions of sale</h2>
    <ul>{% for t in vm.terms %}<li>{{ t }}</li>{% endfor %}</ul>
    {% endif %}

    {% if vm.gallery_photos %}
    <h2>Gallery</h2>
    <div class="gallery">{% for src in vm.gallery_photos %}<img src="{{ src }}" alt="Property photo" />{% endfor %}</div>
    {% endif %}

    {% if is_auction %}
    <h2>How the auction works</h2>
    <ol class="steps">
      <li>Register to bid with Dynamic Auctioneers before the auction closes.</li>
      <li>The auction is held{% if vm.auction_channel %} {{ vm.auction_channel | lower }}{% endif %}{% if vm.auction_date %} on {{ vm.auction_date }}{% endif %}{% if vm.auction_time %} at {{ vm.auction_time }}{% endif %}.</li>
      <li>The highest bid is subject to the seller's confirmation.</li>
      <li>The successful bidder signs the conditions of sale and pays the required deposit.</li>
    </ol>
    {% else %}
    <h2>How to proceed</h2>
    <ol class="steps">
      <li>View the property by appointment through Dynamic Auctioneers.</li>
      <li>Submit a written offer to Dynamic Auctioneers.</li>
      <li>Offers are presented to the seller for consideration.</li>
      <li>Any sale is subject to the conditions of sale and the seller's confirmation.</li>
    </ol>
    {% endif %}

    <h2>Enquiries</h2>
    <table class="kv">
      <tr><td>Handled by</td><td>Dynamic Auctioneers</td></tr>
      <tr><td>Telephone</td><td>{{ vm.brand_phone }}</td></tr>
      <tr><td>Email</td><td>{{ vm.brand_email }}{% if vm.brand_email_admin %}<br>{{ vm.brand_email_admin }}{% endif %}</td></tr>
      <tr><td>Web</td><td>{{ vm.brand_web }}</td></tr>
      {% if vm.viewing_by_appt %}<tr><td>Viewing</td><td>Strictly by appointment</td></tr>{% endif %}
    </table>

    <h2>Disclaimers</h2>
    <p class="disc"><strong>Marketing note.</strong> This pack is for marketing purposes only. It is not an offer, a warranty or advice. All figures are approximate and drawn from public deeds records, third-party data and the owner's information, and have not been independently verified. Buyers must conduct their own due diligence. {{ 'Any sale by auction is' if is_auction else 'Any sale is' }} subject to the conditions of sale and confirmation by the seller.</p>
    <p class="disc"><strong>Legal disclaimer.</strong> Whilst all reasonable care has been taken to provide accurate information, neither Dynamic Solutions 1068 (Pty) LTD Trading As Dynamic Auctioneers nor the Seller/s guarantee the correctness of the information provided herein and neither will be held liable for any direct or indirect damages or loss, of whatsoever nature, suffered by any person as a result of errors or omissions in the information provided, whether due to negligence or otherwise of Dynamic Solutions 1068 (Pty) LTD Trading As Dynamic Auctioneers or the Seller/s or any other person.</p>
  </div>
  {{ brand.footer(vm) }}
</div>
