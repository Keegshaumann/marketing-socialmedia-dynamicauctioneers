{% macro icon_dining() %}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="3"/></svg>{% endmacro %}
{# Open-plan living: one room outline whose internal wall stops short on both
   sides, leaving a wide opening in the middle - two spaces running into each
   other. The sofa glyph read as "a lounge", which is exactly the thing an
   open-plan line is saying it is NOT (D92). #}
{% macro icon_openplan() %}<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M12 5v3M12 16v3"/></svg>{% endmacro %}
{% macro icon_patio() %}<svg viewBox="0 0 24 24"><path d="M12 4v16"/><path d="M4 11a8 8 0 0 1 16 0z"/></svg>{% endmacro %}

{% macro feature_icon(text) -%}
  {%- set t = (text or '') | lower -%}
  {%- if 'open-plan' in t or 'open plan' in t -%}{{ icon_openplan() }}
  {%- elif 'kitchen' in t or 'scullery' in t or 'pantry' in t -%}{{ icon_kitchen() }}
  {%- elif 'study' in t or 'office' in t -%}{{ icon_study() }}
  {%- elif 'garden' in t or 'lawn' in t or 'yard' in t -%}{{ icon_garden() }}
  {%- elif 'bar' in t or 'bbq' in t or 'braai' in t or 'entertain' in t -%}{{ icon_bar() }}
  {%- elif 'pool' in t -%}{{ icon_pool() }}
  {# Patio and balcony BEFORE lounge/living: "Balcony leading from the lounge"
     is a balcony, and matching anywhere drew it a sofa (D92). #}
  {%- elif 'patio' in t or 'balcon' in t or 'veranda' in t or 'deck' in t or 'stoep' in t -%}{{ icon_patio() }}
  {%- elif 'lounge' in t or 'living' in t or 'tv room' in t or 'family room' in t -%}{{ icon_sofa() }}
  {%- elif 'dining' in t -%}{{ icon_dining() }}
  {%- else -%}{{ icon_feature() }}
  {%- endif -%}
{%- endmacro %}
