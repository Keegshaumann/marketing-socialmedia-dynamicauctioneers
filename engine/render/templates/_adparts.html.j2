{# Shared pieces for the Dynamic ad designs (D43): method-aware badge, money /
   auction line, brand logo and the stat icons. Keeping these in one macro file
   means the Collage / Feature-list / Stats-first designs stay consistent - the
   badge wording, the auction-vs-price rule and the brand switch live once. #}

{# Badge: "<TYPE> AUCTION!" / "ON AUCTION!" on an auction, "<TYPE> SALE!" /
   "FOR SALE!" otherwise. The type (Insolvency, Liquidation, ...) applies to both
   methods; only the SALE/AUCTION word flips (matches the real ads). #}
{% macro badge_text(vm) -%}
  {%- set t = vm.auction_type -%}
  {%- if vm.method == 'auction' -%}
    {%- if t %}{{ t|upper }} AUCTION{% else %}ON AUCTION{% endif -%}
  {%- else -%}
    {%- if t %}{{ t|upper }} SALE{% else %}FOR SALE{% endif -%}
  {%- endif -%}!
{%- endmacro %}

{# The headline money row: the channel/date/time line on an auction (there is no
   price on an auction ad), the display price otherwise. #}
{% macro money_text(vm) -%}
  {%- if vm.method == 'auction' -%}
    {{ (vm.auction_channel or 'Online') | upper }} AUCTION{% if vm.auction_date %} | {{ vm.auction_date | upper }}{% endif %}{% if vm.auction_time %} @ {{ vm.auction_time }}{% endif %}
  {%- else -%}
    {{ vm.price_display or 'Offers invited' }}
  {%- endif -%}
{%- endmacro %}

{# Method-aware brand logo: Auctioneers on an auction, Real Estate otherwise.
   variant is 'dark' (white logo, for dark chrome) or 'light' (black logo). #}
{% macro brand_logo(vm, on='light') -%}
  {#- `on` names the BACKGROUND the logo sits on, NOT the logo's colour:
        on='light' -> logo-<brand>-on-light.png = the full black+gold "DS DYNAMIC"
                      lockup, legible on a white/light surface;
        on='dark'  -> logo-<brand>-on-dark.png  = the gold-only mark, legible on a
                      dark surface (the black lockup would vanish there).
     Picking the wrong one hides half the logo, so pass the surface colour. -#}
  {%- set which = 'auctioneers' if vm.method == 'auction' else 'realestate' -%}
  <img src="{{ asset_uri('ads/_assets/logo-' ~ which ~ '-on-' ~ on ~ '.png') }}" alt="{{ vm.brand_name }}"/>
{%- endmacro %}

