{# Shared pieces for the Dynamic ad designs (D43): method-aware badge, money /
   auction line, brand logo and the stat icons. Keeping these in one macro file
   means the Collage / Feature-list / Stats-first designs stay consistent - the
   badge wording, the auction-vs-price rule and the brand switch live once. #}

{# Badge: "<CALLOUT> AUCTION!" / "ON AUCTION!" on an auction, "<CALLOUT> SALE!" /
   "FOR SALE!" otherwise. The callout (Insolvency, Liquidation, ...) applies to
   both methods; only the SALE/AUCTION word flips (matches the real ads).

   The callout is meant to be the REASON, but a marketer can reasonably type
   "For sale" or "Insolvency auction" into that box. If it already ends in the
   word we would append, take it as written rather than printing the reported
   "FOR SALE SALE!". Compared as a whole last word, so "Wholesale" is still
   given its suffix. #}
{% macro badge_text(vm) -%}
  {%- set word = 'AUCTION' if vm.method == 'auction' else 'SALE' -%}
  {%- set callout = ((vm.auction_type or '') | replace('!', '') | trim | upper) -%}
  {%- set parts = callout.split() -%}
  {%- if not parts -%}
    {{- 'ON AUCTION' if vm.method == 'auction' else 'FOR SALE' -}}
  {%- elif parts[-1] == word -%}
    {{- callout -}}
  {%- else -%}
    {{- callout }} {{ word -}}
  {%- endif -%}!
{%- endmacro %}

{# The headline money row: the channel/date/time line on an auction (there is no
   price on an auction ad), the display price otherwise. #}
{# The ads' auction line is fixed by D42 and does NOT carry the weekday; the
   BOARD does (vm.auction_weekday, D71), because that is what its reference
   prints. One macro serving both would have changed every advert. #}
{% macro money_text(vm) -%}
  {%- if vm.method == 'auction' -%}
    {{ (vm.auction_channel or 'Online') | upper }} AUCTION{% if vm.auction_date %} | {{ vm.auction_date | upper }}{% endif %}{% if vm.auction_time %} @ {{ vm.auction_time }}{% endif %}
  {%- else -%}
    {{ vm.price_display or 'Offers invited' }}
  {%- endif -%}
{%- endmacro %}

{# Method-aware brand logo: Auctioneers on an auction, Real Estate otherwise.
   variant is 'dark' (white logo, for dark chrome) or 'light' (black logo).

   `brand` pins the lockup instead of deriving it from the sale method, for a
   surface that names one brand in words and must not contradict itself. The
   information pack is issued as Dynamic Auctioneers whatever the sale method
   (playbook 1 and 9: running head, contact block and legal entity all say
   Dynamic Auctioneers), so it pins 'auctioneers'. #}
{% macro brand_logo(vm, on='light', brand=None) -%}
  {#- `on` names the BACKGROUND the logo sits on, NOT the logo's colour:
        on='light' -> logo-<brand>-on-light.png = the full black+gold "DS DYNAMIC"
                      lockup, legible on a white/light surface;
        on='dark'  -> logo-<brand>-on-dark.png  = the gold-only mark, legible on a
                      dark surface (the black lockup would vanish there).
     Picking the wrong one hides half the logo, so pass the surface colour. -#}
  {%- set which = brand or ('auctioneers' if vm.method == 'auction' else 'realestate') -%}
  <img src="{{ asset_uri('ads/_assets/logo-' ~ which ~ '-on-' ~ on ~ '.png') }}" alt="{{ vm.brand_name }}"/>
{%- endmacro %}

{# Garage count as the real ads word it: Single / Double / Triple, then numeric. #}
{% macro garage_word(n) -%}
  {%- if n == '1' -%}Single Garage
  {%- elif n == '2' -%}Double Garage
  {%- elif n == '3' -%}Triple Garage
  {%- else -%}{{ n }} Garages
  {%- endif -%}
{%- endmacro %}

