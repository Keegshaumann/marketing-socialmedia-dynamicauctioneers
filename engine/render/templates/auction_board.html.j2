{# On-site auction board (SPEC 12 step 6d), rebuilt to the team's own board:
   designs/incoming/DP2817.3 - AUCTION BOARD.png (fix list 6.1, 6.2, 6.5-6.7).

   1200 x 1600, and **no property photograph** (6.1): a board is read from a
   pavement at speed, so it carries the facts that make someone stop, not a
   picture they can see by looking up. The billboard is a separate, landscape
   artefact and is not this.

   Structure, top to bottom, straight off the reference:
     black header band   channel | WEEKDAY over the date and time
     ref pill            MASTER REF, top right, outlined
     headline stack      bedrooms / extent + type / suburb, city
     method box          two-tone "LIQUIDATION | AUCTION"
     QR                  the code the team uploaded (D69); omitted when none
     phone               the number for THIS board
     black footer        the full lockup

   The weekday is derived from the auction date (D71), never typed. Residential
   boards always print bedrooms and commercial/agricultural ones always print the
   extent (6.5, 6.6), because those are the two facts that decide whether a
   passer-by is the buyer. #}
{% import "_adparts.html.j2" as parts %}

{% set is_auction = (vm.method == 'auction') %}

{# The header's first line: how it is sold and on which day. #}
{% set channel = (vm.auction_channel or 'Online') if is_auction else 'For sale' %}

{# The method box, two tone. An auction names its type; a listing reads FOR SALE. #}
{% set box_lead = (vm.auction_type or 'Liquidation') if is_auction else 'For' %}
{% set box_tail = 'Auction' if is_auction else 'Sale' %}

{# The reference number a passer-by quotes. The master (mandate) ref when the
   record carries one, the property ref otherwise: printing both on a board read
   from six metres away is two numbers nobody writes down (6.2). #}
{% set ref_label = 'Master ref' if vm.public_ref else 'Property ref' %}
{% set ref_value = vm.public_ref or vm.property_ref %}

{# Line 1 of the stack: bedrooms for a home, extent for anything else. A board
   that says neither tells a passer-by nothing about whether it is for them. #}
{% set lead_line %}
{%- if vm.beds %}{{ vm.beds }}-BED
{%- elif vm.size_ha %}± {{ vm.size_ha }} HA
{%- elif vm.size_str %}± {{ vm.size_str }}M²{% endif -%}
{% endset %}

{# Line 2: the extent and the property type together, so a residential board
   still states its size and a commercial one still states what it is. #}
{# The descriptor usually opens with the bed count ("3 Bedroom Apartment"), and
   the lead line above already says "3-BED", so it is stripped here rather than
   printed twice on a board with room for six words. #}
{% set descriptor = vm.descriptor_line or vm.title_type_label or 'Property' %}
{% set type_word = (descriptor | regex_strip_beds) if vm.beds else descriptor %}
{% set size_line %}
{%- if vm.beds and vm.size_ha %}± {{ vm.size_ha }} HA {{ type_word }}
{%- elif vm.beds and vm.size_str %}± {{ vm.size_str }}M² {{ type_word }}
{%- else %}{{ type_word }}{% endif -%}
{% endset %}

{% set place = vm.place_line or vm.suburb or '' %}
{# One number, and only a number (see _board_phone): the contact field is free
   text and has held a name, a number and an email at once. #}
{% set phone = vm.board_phone or vm.brand_phone %}

{# Type steps down by length rather than letting a long suburb push the layout. #}
{% set place_px = 62 if (place | length) <= 22 else (52 if (place | length) <= 30 else 42) %}
{% set size_px = 58 if (size_line | trim | length) <= 24 else (48 if (size_line | trim | length) <= 32 else 38) %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Board {{ place or vm.headline }} | {{ vm.brand_name }}</title>
<style>
  :root { --ink:#000; --gold:#ac874a; --gold-2:#ddc689; --paper:#f4efe6; }
  * { box-sizing: border-box; }
  html, body { margin:0; padding:0; background:#fff; }
  body { font-family:'Montserrat','Avenir Next',Arial,sans-serif; -webkit-font-smoothing:antialiased; }

  /* The board itself: a locked 1200x1600 canvas, printed at exactly that size. */
  .board {
    position:relative; width:1200px; height:1600px; overflow:hidden;
    background:var(--paper); display:flex; flex-direction:column;
    -webkit-print-color-adjust:exact; print-color-adjust:exact;
  }

  /* The diagonal sheen of the reference: pale bands across an ivory ground. */
  .bd-ground { position:absolute; inset:0; z-index:0;
    background:
      linear-gradient(118deg, rgba(255,255,255,.95) 0 32%, rgba(255,255,255,0) 32% 44%,
                              rgba(255,255,255,.75) 44% 58%, rgba(255,255,255,0) 58% 72%,
                              rgba(255,255,255,.85) 72% 100%),
      linear-gradient(160deg, #ffffff 0%, #f6f1e7 55%, #e8dcc6 100%);
  }

  .bd-head {
    position:relative; z-index:2; flex:none; background:var(--ink); color:#fff;
    padding:34px 40px 38px; text-align:center;
  }
  .bd-head .l1 { font-size:76px; font-weight:900; line-height:1.02; letter-spacing:-.01em; text-transform:uppercase; }
  .bd-head .l2 { margin-top:10px; font-size:70px; font-weight:900; line-height:1.02; letter-spacing:-.01em; text-transform:uppercase; }

  .bd-body { position:relative; z-index:2; flex:1 1 auto; display:flex; flex-direction:column;
             align-items:center; padding:26px 46px 30px; min-height:0; }
  .bd-mid { margin-top:auto; margin-bottom:auto; display:flex; flex-direction:column; align-items:center; }

  .bd-ref { align-self:flex-end; border:3px solid var(--ink); border-radius:999px;
            padding:12px 26px; font-size:22px; font-weight:800; letter-spacing:.02em;
            text-transform:uppercase; color:var(--ink); background:rgba(255,255,255,.75); }

  .bd-stack { margin-top:14px; text-align:center; color:var(--ink); }
  .bd-stack .lead { font-size:84px; font-weight:900; line-height:1.0; letter-spacing:-.02em; text-transform:uppercase; }
  .bd-stack .size { margin-top:6px; font-weight:900; line-height:1.02; letter-spacing:-.02em; text-transform:uppercase; }
  .bd-stack .place { margin-top:6px; font-weight:900; line-height:1.02; letter-spacing:-.01em; text-transform:uppercase; }

  /* The two-tone method box: outlined, half black-on-white, half white-on-black. */
  .bd-method { margin-top:24px; display:flex; border:4px solid var(--ink); }
  .bd-method span { padding:12px 22px; font-size:52px; font-weight:900; line-height:1;
                    letter-spacing:-.01em; text-transform:uppercase; }
  .bd-method .a { background:#fff; color:var(--ink); }
  .bd-method .b { background:var(--ink); color:#fff; }

  .bd-qr { margin-top:26px; width:330px; height:330px; border:4px solid var(--ink);
           background:#fff; padding:10px; }
  .bd-qr img { width:100%; height:100%; object-fit:contain; display:block; }

  .bd-tel { margin-top:34px; padding-top:0; display:flex; align-items:center; gap:22px;
            font-size:76px; font-weight:900; color:var(--ink); letter-spacing:-.01em; }
  .bd-tel .dot { width:74px; height:74px; border-radius:50%; background:var(--ink);
                 display:flex; align-items:center; justify-content:center; flex:none; }
  .bd-tel .dot svg { width:42px; height:42px; fill:#fff; }

  .bd-foot { position:relative; z-index:2; flex:none; background:var(--ink);
             padding:30px 40px; display:flex; align-items:center; justify-content:center; }
  .bd-foot img { height:118px; width:auto; display:block; }

  .nb{white-space:nowrap}
  .un{text-transform:none}
</style>
</head>
<body>

<div class="board ad">
  <div class="bd-ground"></div>

  <div class="bd-head">
    <div class="l1">{{ channel | upper }}{% if vm.auction_weekday %} | {{ vm.auction_weekday }}{% endif %}</div>
    {% if vm.auction_date or vm.auction_time %}
    <div class="l2">{{ vm.auction_date | upper }}{% if vm.auction_time %} @ {{ vm.auction_time }}{% endif %}</div>
    {% elif not is_auction %}
    <div class="l2">{{ vm.price_display | upper }}</div>
    {% endif %}
  </div>

  <div class="bd-body">
    {% if ref_value %}
    <div class="bd-ref">{{ ref_label }}: {{ ref_value }}</div>
    {% endif %}

    <div class="bd-mid">
    <div class="bd-stack">
      {% if lead_line | trim %}<div class="lead nb">{{ lead_line | trim }}</div>{% endif %}
      {% if size_line | trim %}<div class="size" style="font-size:{{ size_px }}px">{{ size_line | trim }}</div>{% endif %}
      {% if place %}<div class="place" style="font-size:{{ place_px }}px">{{ place }}</div>{% endif %}
    </div>

    <div class="bd-method">
      <span class="a">{{ box_lead }}</span><span class="b">{{ box_tail }}</span>
    </div>

    {# The QR the team generated and uploaded (D69). Nothing is drawn without
       one: an empty white square on a printed board is worse than no square. #}
    {% if vm.qr_src %}
    <div class="bd-qr"><img src="{{ vm.qr_src }}" alt="Scan for this property"></div>
    {% endif %}

    <div class="bd-tel">
      <span class="dot"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.4.55 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.3a1 1 0 0 1 1 1 11 11 0 0 0 .55 3.4 1 1 0 0 1-.24 1z"/></svg></span>
      <span class="nb">{{ phone }}</span>
    </div>
    </div>
  </div>

  <div class="bd-foot">{{ parts.brand_logo(vm, 'dark', 'auctioneers') }}</div>
</div>

</body>
</html>
