<!doctype html>
<html lang="en"><head><meta charset="utf-8">
{# The A4 information pack, laid out like the team's DP2987 pack (Oct 2026). #}
<style>
@page{size:A4;margin:0}
:root{--gold:linear-gradient(90deg,#ac874a 0%,#ddc689 55%,#c7a560 100%);--goldv:linear-gradient(180deg,#f6e5ab 0%,#ddbd73 42%,#b48c47 78%,#9a7638 100%);--goldline:#c9a45c;--ink:#111}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:#d9d9d9}
body{font-family:'Montserrat',sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.page{width:794px;height:1123px;position:relative;overflow:hidden;background:#fff;page-break-after:always;break-after:page;margin:0 auto 16px}
@media print{.page{margin:0}html,body{background:#fff}}
/* Solid gold in print: Chrome's PDF output draws clipped gradient text as a box. */
.goldtext{color:#c9a45c}
.goldbar{background:var(--gold);color:var(--ink)}
.fit{white-space:nowrap;overflow:hidden}
.ic{display:inline-flex;align-items:center;justify-content:center;flex:none}
.ic svg{width:100%;height:100%;display:block}
.ic.unit{border:3px solid currentColor;border-radius:3px;font-weight:800}
.ic.unit span{font-size:.4em;line-height:1}
.corner-tr{position:absolute;right:0;top:0;width:118px;height:118px;background:var(--gold);clip-path:polygon(0 0,100% 0,100% 100%)}
.corner-bl{position:absolute;left:0;bottom:0;width:150px;height:150px;background:var(--gold);clip-path:polygon(0 0,100% 100%,0 100%)}
.pno{position:absolute;right:30px;bottom:22px;font-weight:800;font-size:13px;color:#a7843f}
.inner{position:absolute;left:64px;right:64px;top:56px;bottom:70px}
h1{font-weight:800;font-size:24px;text-align:center;letter-spacing:.02em;margin-bottom:22px}
h1 b{color:#a7843f;font-weight:800}
h2{font-weight:800;font-size:15px;letter-spacing:.02em;margin:16px 0 8px}
table.kv{width:100%;border-collapse:collapse;font-size:10.5px}
table.kv td{border:1px solid #d6cfbf;padding:7px 10px;vertical-align:top;line-height:1.35}
table.kv td.k{width:34%;background:#f3efe6;font-weight:800;text-transform:uppercase;font-size:9.5px;letter-spacing:.02em}
.terms{border:1.5px solid #222;border-radius:4px;padding:14px 18px;font-size:11px;line-height:1.6;text-align:center}
.pill{display:inline-block;background:var(--gold);border-radius:14px;padding:4px 18px;font-weight:800;font-size:11px;margin-top:8px}
.viewing{border:1.5px solid #222;margin-top:16px;padding:10px;text-align:center;font-weight:800;font-size:17px}
p.body{font-size:11.5px;line-height:1.65;margin-bottom:12px;text-align:justify}
.photo{border:3px solid var(--goldline);overflow:hidden;background:#eee}
.photo img{width:100%;height:100%;object-fit:cover;display:block}
.groups{display:grid;grid-template-columns:1fr 1fr;gap:26px 34px}
.group h3{font-weight:800;font-size:13px;text-align:center;letter-spacing:.02em;margin-bottom:14px;min-height:32px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px 12px}
.item{display:flex;flex-direction:column;align-items:center;text-align:center;gap:7px;font-size:8.8px;font-weight:700;text-transform:uppercase;line-height:1.3}
ul.dots{font-size:11.5px;line-height:1.7;padding-left:18px}
.toc{font-size:13px;line-height:2.4}
.toc .row{display:flex;gap:8px}
.toc .dots{flex:1;border-bottom:1.5px dotted #888;transform:translateY(-8px)}
</style></head><body>

{% set auction_word = 'ON AUCTION' if auction else 'FOR SALE' %}

{# ---------------------------------- cover ---------------------------------- #}
<div class="page" style="background:#000">
  {% if aerial %}<img src="{{ aerial }}" style="position:absolute;left:0;top:0;width:794px;height:850px;object-fit:cover">{% endif %}
  <div style="position:absolute;left:0;top:0;width:470px;height:246px;background:rgba(0,0,0,.82);padding:26px 30px;color:#fff;display:flex;flex-direction:column;justify-content:center">
    <div class="fit" data-fit data-min="20" style="font-weight:900;font-size:40px">{{ (f.pack_title or f.short_title or f.subline) | nb }}</div>
    <div class="goldtext fit" data-fit data-min="12" style="font-weight:700;font-size:20px;margin-top:8px">{{ f.pack_region | nb }}</div>
    <div style="font-weight:900;font-size:34px;margin-top:10px">{{ auction_word }}</div>
  </div>
  <div style="position:absolute;right:34px;top:0;width:164px;height:196px;background:#fff;clip-path:polygon(0 0,100% 0,100% 84%,50% 100%,0 84%);display:flex;justify-content:center"><img src="{{ logo('auctioneers-on-light' if auction else 'realestate-on-light') }}" style="width:122px;height:122px;margin-top:16px"></div>
  {% if f.pack_strapline %}<div class="goldbar fit" data-fit data-min="8" style="position:absolute;left:0;top:850px;width:794px;height:46px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;padding:0 20px">{{ f.pack_strapline | nb }}</div>{% endif %}
  <div style="position:absolute;left:0;top:896px;width:794px;height:180px;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px">
    {% if auction %}
    <div class="fit" data-fit data-min="16" style="font-weight:900;font-size:34px;border:2px solid var(--goldline);padding:8px 26px;max-width:740px">{{ auction_line | nb }}</div>
    {% else %}
    <div class="fit" data-fit data-min="16" style="font-weight:900;font-size:34px;border:2px solid var(--goldline);padding:8px 26px;max-width:740px">{{ (f.price or 'MAKE US AN OFFER!') | nb }}</div>
    {% endif %}
    {% if f.viewing %}<div style="font-weight:700;font-size:15px">VIEWING: {{ f.viewing | nb }}</div>{% endif %}
  </div>
  {% if f.pack_footer %}<div class="goldbar fit" data-fit data-min="8" style="position:absolute;left:0;bottom:0;width:794px;height:46px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;padding:0 20px">{{ f.pack_footer | nb }}</div>{% endif %}
</div>

{# ---------------------------------- contents ---------------------------------- #}
<div class="page">
  <div class="corner-tr"></div><div class="corner-bl"></div>
  {% if photo1 %}<img src="{{ photo1 }}" style="position:absolute;left:0;bottom:0;width:794px;height:420px;object-fit:cover;clip-path:polygon(0 30%,100% 0,100% 100%,0 100%)">{% endif %}
  <div class="inner" style="top:90px">
    <div style="font-weight:900;font-size:26px;letter-spacing:.02em;margin-bottom:30px">TABLE OF CONTENTS:</div>
    <div class="toc">
    {% for no, title, pages in toc %}
      <div class="row"><span>{{ no }}. {{ title }}</span><span class="dots"></span><span>{{ pages }}</span></div>
    {% endfor %}
    </div>
  </div>
</div>

{# ---------------------------------- the sections ---------------------------------- #}
{% for pg in pack_pages %}
<div class="page">
  <div class="corner-tr"></div><div class="corner-bl"></div>
  <div class="pno">{{ pg.no }}.</div>
  <div class="inner">

  {% if pg.kind == 'overview' %}
    <h1><b>{{ pg.section }}.</b> PROPERTY OVERVIEW</h1>
    <table class="kv">
      {% for r in f.overview %}<tr><td class="k">{{ r.label }}</td><td>{{ r.text | nb }}</td></tr>{% endfor %}
    </table>
    {% if f.rates %}
    <div style="display:flex;gap:16px;margin-top:16px">
      {% for r in f.rates[:4] %}
      <div style="flex:1;border:1px solid #d6cfbf;padding:10px;display:flex;gap:10px;align-items:center;font-size:10.5px">
        <span style="font-size:22px;color:#a7843f">{{ icon('home', 30) }}</span>
        <div><div style="font-weight:800;text-transform:uppercase;font-size:9.5px">{{ r.label }}</div><div>Rates &amp; Taxes: {{ r.text | nb }}</div></div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    <div class="goldbar" style="margin:18px auto 0;width:70%;border-radius:16px;padding:6px 10px;text-align:center;font-weight:800;font-size:11px">All Outstanding Fees, if any, to be Settled by the Seller.</div>
    {% if f.terms or f.confirmation %}{# from the OTP; no box at all rather than an empty one #}
    <h2 style="font-size:20px;font-weight:900">SALE OVERVIEW</h2>
    <div class="terms">
      {% for t in f.terms %}<div>{{ t | nb }}</div>{% endfor %}
      {% if f.confirmation %}<div class="pill">{{ f.confirmation | nb }}</div>{% endif %}
    </div>
    {% endif %}
    {% if f.viewing %}<div class="viewing">VIEWING:<br>{{ f.viewing | nb }}</div>{% endif %}

  {% elif pg.kind == 'description' %}
    <h1><b>{{ pg.section }}.</b> PROPERTY DESCRIPTION</h1>
    {% for para in f.description %}<p class="body">{{ para | nb }}</p>{% endfor %}
    <div style="display:flex;gap:18px;margin-top:10px">
      {% for p in [photo1, photo2] %}{% if p %}<div class="photo" style="flex:1;height:200px"><img src="{{ p }}"></div>{% endif %}{% endfor %}
    </div>
    {% if f.features %}
    <h2 style="text-align:center;margin-top:26px;font-size:17px">KEY FEATURES</h2>
    <div style="display:flex;justify-content:space-around;margin-top:12px">
      {% for ft in f.features[:5] %}<div class="item" style="width:118px">{{ icon(ft.icon, 46, 42) }}<span>{{ ft.text | nb }}</span></div>{% endfor %}
    </div>
    {% endif %}

  {% elif pg.kind == 'details' %}
    <h1><b>{{ pg.section }}.</b> PROPERTY DETAILS</h1>
    {% for p in f.portions[:3] %}
      <h2>{{ p.label | nb }}</h2>
      <table class="kv">
        {% for k, v in [('Legal description', p.legal_description), ('Extent', p.extent), ('Municipality', p.municipality), ('Zoning', p.zoning), ('Title deed', p.title_deed)] %}
          {% if v %}<tr><td class="k">{{ k }}</td><td>{{ v | nb }}</td></tr>{% endif %}
        {% endfor %}
      </table>
    {% endfor %}
    {% if aerial %}<div class="photo" style="height:{{ 330 if f.portions|length < 2 else 230 }}px;margin-top:20px"><img src="{{ aerial }}"></div>{% endif %}

  {% elif pg.kind == 'improvements' %}
    <h1><b>{{ pg.section }}.</b> MAIN IMPROVEMENTS</h1>
    <div class="groups">
      {% for g in pg.groups %}
      <div class="group">
        <h3>{{ g.title | nb }}</h3>
        <div class="grid">
          {% for it in g['items'][:8] %}<div class="item">{{ icon(it.icon, 40, 36) }}<span>{{ it.text | nb }}</span></div>{% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>

  {% elif pg.kind == 'use' %}
    {% if f.best_use %}
    <h1><b>{{ pg.section }}.</b> HIGHEST &amp; BEST USE</h1>
    <p class="body">The highest and best use of the property is considered to be:</p>
    <ul class="dots">{% for b in f.best_use %}<li>{{ b | nb }}</li>{% endfor %}</ul>
    {% endif %}
    {% if f.condition %}
    <h1 style="margin-top:40px">PROPERTY CONDITION</h1>
    <table class="kv">{% for r in f.condition %}<tr><td class="k">{{ r.label }}</td><td>{{ r.text | nb }}</td></tr>{% endfor %}</table>
    {% endif %}

  {% elif pg.kind == 'gallery' %}
    <h1>{% if pg.first %}<b>{{ pg.section }}.</b> PHOTOGRAPHIC OVERVIEW{% else %}&nbsp;{% endif %}</h1>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      {% for p in pg.photos %}<div class="photo" style="height:{{ 270 if pg.first else 290 }}px"><img src="{{ p }}"></div>{% endfor %}
    </div>

  {% elif pg.kind == 'highlights' %}
    <h1><b>{{ pg.section }}.</b> INVESTMENT HIGHLIGHTS</h1>
    <table class="kv">{% for r in f.highlights %}<tr><td class="k">{{ r.label | nb }}</td><td>{{ r.text | nb }}</td></tr>{% endfor %}</table>
  {% endif %}

  </div>
</div>
{% endfor %}

{# ---------------------------------- back cover ---------------------------------- #}
<div class="page">
  <div style="position:absolute;left:0;right:0;top:70px;display:flex;flex-direction:column;align-items:center;text-align:center">
    <img src="{{ logo('auctioneers-on-light') }}" style="width:230px">
    <div class="fit" data-fit data-min="18" style="font-weight:900;font-size:34px;margin-top:26px;max-width:680px">{{ (f.pack_title or f.short_title) | nb }}</div>
    <div style="font-weight:700;font-size:17px;margin-top:6px">{{ f.pack_region | nb }}</div>
    <div style="font-weight:900;font-size:17px;margin-top:34px;line-height:1.4">DISCOVER THE POTENTIAL.<br>SECURE THE OPPORTUNITY.<br>{{ "DON'T MISS THIS AUCTION." if auction else "MAKE YOUR OFFER TODAY." }}</div>
    <div style="margin-top:30px;font-size:13px;font-weight:600;line-height:2.1;text-align:left">
      <div style="display:flex;align-items:center;gap:12px">{{ icon('location_on', 20) }}187 Gouws Avenue, Raslouw AH, Centurion</div>
      <div style="display:flex;align-items:center;gap:12px">{{ icon('home', 20) }}dynamicauctioneers.co.za</div>
      <div style="display:flex;align-items:center;gap:12px">{{ icon('mail', 20) }}{{ f.email }}</div>
      <div style="display:flex;align-items:center;gap:12px">{{ icon('call', 20) }}{{ f.phone | nb }}</div>
    </div>
  </div>
  {% if aerial %}<img src="{{ aerial }}" style="position:absolute;left:0;bottom:0;width:794px;height:330px;object-fit:cover;clip-path:polygon(0 25%,100% 0,100% 100%,0 100%)">{% endif %}
</div>

<script>
(function () {
  function fit() {
    document.querySelectorAll('[data-fit]').forEach(function (el) {
      var s = parseFloat(getComputedStyle(el).fontSize), min = parseFloat(el.dataset.min || 8), i = 0;
      var oneLine = el.classList.contains('fit');
      function over() { return el.scrollWidth > el.clientWidth + 1 || (!oneLine && el.scrollHeight > el.clientHeight + 1); }
      while (over() && s > min && i < 300) { s -= 1; el.style.fontSize = s + 'px'; i++; }
    });
  }
  function done() { fit(); document.body.dataset.ready = '1'; }
  var waiting = [].slice.call(document.images).filter(function (i) { return !i.complete; })
    .map(function (i) { return new Promise(function (r) { i.onload = i.onerror = r; }); });
  Promise.all([document.fonts.ready].concat(waiting)).then(done);
  setTimeout(done, 15000);
})();
</script>
</body></html>
