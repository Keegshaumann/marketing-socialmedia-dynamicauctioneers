<!doctype html>
<html lang="en"><head><meta charset="utf-8">
{# The A4 information pack, after the team's packs (DP2987, and since 25 Nov 2026 their newer DP2969 and
   DP3114): gold-edged cards with big icons, gold dividers, tables where a list reads better as one.
   The sections run on from page to page, as blocks the script at the end lays onto A4 pages: a heading
   never ends a page, and the room a page has left takes a photo, wide or a pair. Photos always keep
   their landscape shape (4:3, a phone photo's own), never cut into a tall strip, and each is used once. #}
<style>
@page{size:A4;margin:0}
:root{--gold:linear-gradient(90deg,#ac874a 0%,#ddc689 55%,#c7a560 100%);--goldv:linear-gradient(180deg,#f6e5ab 0%,#ddbd73 42%,#b48c47 78%,#9a7638 100%);--goldline:#c9a45c;--golddeep:#a7843f;--ink:#111;--paper:#f6f3ec}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:#d9d9d9}
body{font-family:'Montserrat',sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.page{width:794px;height:1123px;position:relative;overflow:hidden;background:#fff;page-break-after:always;break-after:page;margin:0 auto 16px}
@media print{.page{margin:0}html,body{background:#fff}}
.page.inner-page::before{content:"";position:absolute;left:-10%;right:-10%;bottom:-140px;height:420px;background:radial-gradient(ellipse at 30% 100%,#ece8df 0%,rgba(236,232,223,0) 70%);z-index:0}
/* Solid gold in print: Chrome's PDF output draws clipped gradient text as a box. */
.goldtext{color:#c9a45c}
.goldbar{background:var(--gold);color:var(--ink)}
.fit{white-space:nowrap;overflow:hidden}
.ic{display:inline-flex;align-items:center;justify-content:center;flex:none}
.ic svg{width:100%;height:100%;display:block}
.ic.unit{border:3px solid currentColor;border-radius:3px;font-weight:800}
.ic.unit span{font-size:.4em;line-height:1}
.corner-tr{position:absolute;right:0;top:0;width:118px;height:118px;background:var(--gold);clip-path:polygon(0 0,100% 0,100% 100%);z-index:0}
.corner-bl{position:absolute;left:0;bottom:0;width:150px;height:150px;background:var(--gold);clip-path:polygon(0 0,100% 100%,0 100%);z-index:0}
.pno{position:absolute;right:30px;bottom:22px;font-weight:800;font-size:13px;color:var(--golddeep);z-index:2}
.inner{position:absolute;left:56px;right:56px;top:52px;bottom:64px;display:flex;flex-direction:column;gap:14px;z-index:1;overflow:hidden}
.inner > *{flex:none}
#flow{position:absolute;left:-9999px;top:0;width:682px}
h1{font-weight:800;font-size:24px;text-align:center;letter-spacing:.02em}
h1 b{color:var(--golddeep);font-weight:800}
.divider{display:flex;align-items:center;gap:14px;font-weight:900;font-size:15px;letter-spacing:.05em;white-space:nowrap}
.divider::before,.divider::after{content:"";flex:1;height:3px;background:var(--gold);border-radius:2px}
.card{border:2px solid var(--goldline);border-radius:10px;background:#fff;padding:14px 18px;position:relative}
.card__t{display:inline-block;background:#111;color:#fff;font-weight:800;font-size:11px;letter-spacing:.07em;padding:5px 14px;border-radius:0 0 8px 8px;margin:-14px 0 10px;text-transform:uppercase}
table.kv{width:100%;border-collapse:collapse;font-size:10.5px;background:#fff}
table.kv td{border:1px solid #d6cfbf;padding:7px 10px;vertical-align:top;line-height:1.35}
table.kv td.k{width:32%;background:var(--paper);font-weight:800;text-transform:uppercase;font-size:9.5px;letter-spacing:.02em}
table.list{width:100%;border-collapse:collapse;font-size:10.5px;background:#fff}
table.list th{background:#111;color:#fff;font-weight:800;font-size:9.5px;letter-spacing:.06em;text-align:left;padding:7px 10px}
table.list td{border-bottom:1px solid #e4ddcc;padding:6px 10px;line-height:1.3;vertical-align:top}
table.list tr:nth-child(even) td{background:var(--paper)}
table.list td.no{width:34px;color:var(--golddeep);font-weight:800;text-align:right}
.bullets{list-style:none;display:grid;gap:7px;font-size:11px;line-height:1.45}
.bullets li{display:flex;gap:10px;align-items:flex-start}
.bullets li::before{content:"";flex:none;width:9px;height:9px;margin-top:4px;background:var(--goldline);transform:rotate(45deg)}
.pill{display:inline-block;background:var(--gold);border-radius:14px;padding:5px 20px;font-weight:800;font-size:11px}
.viewing{border:2px solid #111;border-radius:8px;padding:9px;text-align:center;font-weight:800;font-size:15px;background:#fff}
p.body{font-size:11.5px;line-height:1.62;text-align:justify}
.photo{border:3px solid var(--goldline);overflow:hidden;background:#eee;border-radius:6px}
.photo img{width:100%;height:100%;object-fit:cover;display:block}
/* photos keep a landscape 4:3 shape: one wide, or a pair */
.prow{display:grid;gap:12px}
.prow--wide{grid-template-columns:1fr}
.prow--pair{grid-template-columns:1fr 1fr}
.prow--trio{grid-template-columns:1fr 1fr 1fr}
.prow .photo{aspect-ratio:4/3}
.feats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.feat{display:flex;align-items:center;gap:12px;border:2px solid var(--goldline);border-radius:10px;padding:10px 12px;background:#fff;font-weight:800;font-size:10.5px;line-height:1.25;text-transform:uppercase;min-height:64px}
.feat .ic{color:var(--golddeep)}
.feat small{display:block;font-size:8.5px;font-weight:700;color:#555;margin-top:2px}
.cards{display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:start}
.irow{display:flex;align-items:center;gap:12px;padding:6px 0;font-weight:700;font-size:10.5px;line-height:1.25;text-transform:uppercase;border-bottom:1px dashed #e2dbc9}
.irow:last-child{border-bottom:0}
.irow .ic{color:var(--golddeep)}
.rates{display:flex;gap:12px}
.rate{flex:1;border:2px solid var(--goldline);border-radius:10px;padding:9px 12px;display:flex;gap:10px;align-items:center;font-size:10.5px;background:#fff}
.rate .ic{color:var(--golddeep)}
.bid{font-size:12px;margin-bottom:10px;text-align:center}
.bid b{color:var(--golddeep)}
.pin{display:flex;align-items:center;gap:12px;border:2px solid var(--goldline);border-radius:10px;padding:8px 12px;background:#fff;font-size:11px}
.pin__t{background:#111;color:#fff;font-weight:800;font-size:10px;letter-spacing:.07em;padding:4px 10px;border-radius:6px}
.pin a{color:var(--golddeep);font-weight:700;text-decoration:none;word-break:break-all}
table.list tr.total td{font-weight:800;background:#efe7d4}
p.note{font-size:9.5px;color:#555;font-style:italic;text-align:center}
.toc{display:grid;gap:12px}
.toc .row{display:flex;align-items:center;gap:14px;font-size:14px;font-weight:700}
.toc .n{width:34px;height:34px;flex:none;border-radius:8px;background:#111;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900}
.toc .dots{flex:1;border-bottom:2px dotted #b9b2a3;transform:translateY(-4px)}
.toc .pg{color:var(--golddeep);font-weight:900}
</style></head><body>

{% set auction_word = 'ON AUCTION' if auction else 'FOR SALE' %}
{% set no = {} %}{% for n, title in sections %}{% set _ = no.update({title: n}) %}{% endfor %}
{% macro head(title, text) -%}<h1 data-sec="{{ title }}" data-keep><b>{{ no[title] }}.</b> {{ text }}</h1>{%- endmacro %}
<script type="application/json" id="pack-photos">{{ pack_photos | tojson }}</script>
<script type="application/json" id="contents-photos">{{ contents_photos | tojson }}</script>

{# ---------------------------------- cover ---------------------------------- #}
<div class="page" style="background:#000">
  {% if aerial %}<img src="{{ aerial }}" style="position:absolute;left:0;top:0;width:794px;height:850px;object-fit:cover">{% endif %}
  <div style="position:absolute;left:0;top:0;width:470px;height:246px;background:rgba(0,0,0,.82);padding:26px 30px;color:#fff;display:flex;flex-direction:column;justify-content:center">
    <div class="fit" data-fit data-min="20" style="font-weight:900;font-size:40px">{{ (f.pack_title or f.short_title or f.subline) | nb }}</div>
    <div class="goldtext fit" data-fit data-min="12" style="font-weight:700;font-size:20px;margin-top:8px">{{ f.pack_region | nb }}</div>
    <div style="font-weight:900;font-size:34px;margin-top:10px">{{ auction_word }}</div>
  </div>
  <div style="position:absolute;right:34px;top:0;width:164px;height:196px;background:#fff;clip-path:polygon(0 0,100% 0,100% 84%,50% 100%,0 84%);display:flex;justify-content:center"><img src="{{ logo('auctioneers-on-light' if auction else 'realestate-on-light') }}" style="width:122px;height:122px;margin-top:16px"></div>
  {% if f.pack_strapline %}<div class="goldbar fit" data-fit data-min="8" style="position:absolute;left:0;top:850px;width:794px;height:46px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;padding:0 20px">{{ f.pack_strapline | nb }}</div>{% endif %}
  <div style="position:absolute;left:0;top:896px;width:794px;height:180px;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px">
    <div class="fit" data-fit data-min="16" style="font-weight:900;font-size:34px;border:2px solid var(--goldline);padding:8px 26px;max-width:740px">{{ (auction_line if auction else (f.price or 'MAKE US AN OFFER!')) | nb }}</div>
    {% if f.viewing %}<div style="font-weight:700;font-size:15px">VIEWING: {{ f.viewing | nb }}</div>{% endif %}
  </div>
  {% if f.pack_footer %}<div class="goldbar fit" data-fit data-min="8" style="position:absolute;left:0;bottom:0;width:794px;height:46px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;padding:0 20px">{{ f.pack_footer | nb }}</div>{% endif %}
</div>

{# ---------------------------------- contents ---------------------------------- #}
<div class="page inner-page" id="contents-page">
  <div class="corner-tr"></div><div class="corner-bl"></div>
  <div class="inner" style="top:70px;gap:22px">
    <div style="font-weight:900;font-size:28px;letter-spacing:.02em">TABLE OF CONTENTS</div>
    <div class="toc">
    {% for n, title in sections %}
      <div class="row"><span class="n">{{ n }}</span><span>{{ title }}</span><span class="dots"></span><span class="pg" data-toc="{{ title }}"></span></div>
    {% endfor %}
    </div>
    <div class="divider" style="font-size:13px">{{ (f.short_title or f.pack_title) | nb }}</div>
  </div>
</div>

{# ---------------------------------- the sections, as blocks ---------------------------------- #}
<div id="flow">
  {% set t_sale = "Auction Information" if auction else "Sale Information" %}
  {{ head(t_sale, t_sale|upper) }}
  {% if f.sale_info %}<table class="kv">{% for r in f.sale_info %}<tr><td class="k">{{ r.label }}</td><td>{{ r.text | nb }}</td></tr>{% endfor %}</table>
  {% elif f.overview %}<table class="kv">{% for r in f.overview %}<tr><td class="k">{{ r.label }}</td><td>{{ r.text | nb }}</td></tr>{% endfor %}</table>{% endif %}
  {% if f.terms or f.confirmation %}
  <div class="divider" data-keep>{{ 'REGISTRATION & BIDDING' if auction else 'MAIN PAYMENT TERMS' }}</div>
  <div class="card">
    {% if auction and (f.auction_kind or 'ONLINE')|upper != 'ON-SITE' %}<div class="bid">Register and bid online at <b>online.dynamicauctioneers.co.za</b></div>{% endif %}
    <ul class="bullets">{% for t in f.terms %}<li>{{ t | nb }}</li>{% endfor %}</ul>
    {% if f.confirmation %}<div style="text-align:center;margin-top:10px"><span class="pill">{{ f.confirmation | nb }}</span></div>{% endif %}
  </div>
  {% endif %}
  {% if f.viewing %}<div class="viewing">VIEWING: {{ f.viewing | nb }}</div>{% endif %}

  {% if f.description or f.features %}
  {{ head("Property Overview", "PROPERTY OVERVIEW") }}
  {% for para in f.description %}<p class="body">{{ para | nb }}</p>{% endfor %}
  {% if f.features %}
  <div class="divider" data-keep>KEY FEATURES</div>
  <div class="feats">
    {% for ft in f.features[:6] %}{% set parts = (ft.text or '').split(' | ', 1) %}
    <div class="feat">{{ icon(ft.icon, 38, 34) }}<span>{{ parts[0] | nb }}{% if parts|length > 1 and parts[1] %}<small>{{ parts[1] | nb }}</small>{% endif %}</span></div>
    {% endfor %}
  </div>
  {% endif %}
  <div data-photos="2"></div>
  {% endif %}

  {{ head("Property Particulars & Location", "PROPERTY PARTICULARS & LOCATION") }}
  {% if f.particulars %}
  <table class="kv">{% for r in f.particulars %}<tr><td class="k">{{ r.label }}</td><td>{{ r.text | nb }}</td></tr>{% endfor %}</table>
  {% else %}
  {% for p in f.portions[:3] %}
  <div class="divider" style="font-size:13px" data-keep>{{ p.label | nb }}</div>
  <table class="kv">
    {% for k, v in [('Legal description', p.legal_description), ('Extent', p.extent), ('Municipality', p.municipality), ('Zoning', p.zoning), ('Title deed', p.title_deed)] %}
      {% if v %}<tr><td class="k">{{ k }}</td><td>{{ v | nb }}</td></tr>{% endif %}
    {% endfor %}
  </table>
  {% endfor %}
  {% endif %}
  {% if f.rates %}
  <div class="rates">
    {% for r in f.rates[:4] %}<div class="rate">{{ icon('home', 28) }}<div><div style="font-weight:800;text-transform:uppercase;font-size:9.5px">{{ r.label }}</div><div>Rates &amp; Taxes: {{ r.text | nb }}</div></div></div>{% endfor %}
  </div>
  {% endif %}
  {% if f.map_pin %}<div class="pin" data-keep><span class="pin__t">MAP PIN</span><a href="https://www.google.com/maps?q={{ f.map_pin|replace(' ', '') }}">google.com/maps?q={{ f.map_pin|replace(' ', '') }}</a></div>{% endif %}
  {% if aerial %}<div class="prow prow--wide" data-fixed><div class="photo"><img src="{{ aerial }}"></div></div>{% endif %}

  {% if f.improvements or f.tables %}
  {{ head("Property Features", "PROPERTY FEATURES") }}
  {% for pair in f.improvements | batch(2) %}
  <div class="cards">
    {% for g in pair %}
    <div class="card"><div class="card__t">{{ g.title | nb }}</div>
      {% for it in g['items'][:12] %}<div class="irow">{{ icon(it.icon, 30, 28) }}<span>{{ it.text | nb }}</span></div>{% endfor %}
    </div>
    {% endfor %}
  </div>
  {% endfor %}
  {% for t in f.tables %}
  <div class="divider" style="font-size:13px" data-keep>{{ t.title | nb }}</div>
  <table class="list">
    <tr>{% for c in t.columns %}<th>{{ c }}</th>{% endfor %}</tr>
    {% for r in t.rows %}<tr class="{{ 'total' if (r[0] or '')|lower in ('total', 'totals') else '' }}">{% for c in r %}<td>{{ c | nb }}</td>{% endfor %}</tr>{% endfor %}
  </table>
  {% endfor %}
  {% endif %}

  {% for sec in f.sections %}
  {{ head(sec.title|title, sec.title|upper) }}
  <div class="card"><ul class="bullets">{% for l in sec.lines %}<li>{{ l | nb }}</li>{% endfor %}</ul></div>
  {% endfor %}

  {% if f.movables %}
  {{ head("Movable Assets", "MOVABLE ASSETS") }}
  <p class="body" style="text-align:center" data-keep>Sold together with the property{{ ' as one lot' if auction else '' }}, voetstoots, as listed in the conditions of sale.</p>
  {% for chunk in f.movables | batch(24) %}
  {% set base = loop.index0 * 24 %}
  {% set half = ((chunk|length + 1) // 2) if chunk|length > 8 else chunk|length %}
  <div style="display:grid;grid-template-columns:{{ '1fr 1fr' if chunk|length > 8 else '1fr' }};gap:14px;align-items:start">
    {% for col in ([chunk[:half], chunk[half:]] if chunk|length > 8 else [chunk]) %}
    {% set offset = base + (0 if loop.first else half) %}
    <table class="list">
      <tr><th style="text-align:right">NO.</th><th>ASSET</th></tr>
      {% for m in col %}<tr><td class="no">{{ offset + loop.index }}</td><td>{{ m | nb }}</td></tr>{% endfor %}
    </table>
    {% endfor %}
  </div>
  {% endfor %}
  {% endif %}

  {% if f.conditions %}
  {{ head("Summary of Sale Conditions", "SUMMARY OF SALE CONDITIONS") }}
  {% for chunk in f.conditions | batch(6) %}
  <table class="kv">{% for r in chunk %}<tr><td class="k">{{ r.label | nb }}</td><td>{{ r.text | nb }}</td></tr>{% endfor %}</table>
  {% endfor %}
  <p class="note">This summary does not replace the full Agreement and Conditions of Sale, the Rules of Auction and any amendments, which govern the sale.</p>
  {% endif %}

  {% if f.fica %}
  {{ head("Registration & FICA Requirements", "REGISTRATION & FICA REQUIREMENTS") }}
  <table class="kv">{% for r in f.fica %}<tr><td class="k">{{ r.label | nb }}</td><td>{{ r.text | nb }}</td></tr>{% endfor %}</table>
  {% endif %}

  {% if gallery %}
  {{ head("Photographic Overview", "PHOTOGRAPHIC OVERVIEW") }}
  <div data-gallery></div>
  {% endif %}

  {% if f.highlights %}
  {{ head("Investment Highlights", "INVESTMENT HIGHLIGHTS") }}
  <table class="kv">{% for r in f.highlights %}<tr><td class="k">{{ r.label | nb }}</td><td>{{ r.text | nb }}</td></tr>{% endfor %}</table>
  <div style="display:flex;justify-content:center"><div class="goldbar" style="border-radius:16px;padding:7px 26px;font-weight:900;font-size:12px;letter-spacing:.04em">{{ "DON'T MISS THIS AUCTION" if auction else "MAKE YOUR OFFER TODAY" }}</div></div>
  {% endif %}
</div>

<div id="pages"></div>
<template id="page-shell"><div class="page inner-page"><div class="corner-tr"></div><div class="corner-bl"></div><div class="pno"></div><div class="inner"></div></div></template>

{# ---------------------------------- back cover ---------------------------------- #}
<div class="page" style="background:#000">
  {% set back = back_photo or hero or aerial %}
  {% if back %}<img src="{{ back }}" style="position:absolute;inset:0;width:794px;height:1123px;object-fit:cover;filter:brightness(.78)">{% endif %}
  <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,.25) 22%,rgba(0,0,0,.55) 48%,rgba(0,0,0,.25) 70%,rgba(0,0,0,.8) 100%)"></div>
  <div style="position:absolute;right:46px;top:0;width:180px;height:214px;background:#fff;clip-path:polygon(0 0,100% 0,100% 84%,50% 100%,0 84%);display:flex;justify-content:center"><img src="{{ logo('auctioneers-on-light' if auction else 'realestate-on-light') }}" style="width:134px;height:134px;margin-top:18px"></div>
  <div style="position:absolute;left:56px;right:56px;top:300px;color:#fff">
    <div class="fit" data-fit data-min="18" style="font-weight:900;font-size:40px;line-height:1.1">{{ (f.pack_title or f.short_title) | nb }}</div>
    <div class="goldtext" style="font-weight:700;font-size:18px;margin-top:8px">{{ f.pack_region | nb }}</div>
    <div style="width:120px;height:4px;background:var(--gold);margin:28px 0"></div>
    <div style="font-weight:900;font-size:20px;line-height:1.45">DISCOVER THE POTENTIAL.<br>SECURE THE OPPORTUNITY.<br>{{ "DON'T MISS THIS AUCTION." if auction else "MAKE YOUR OFFER TODAY." }}</div>
  </div>
  <div style="position:absolute;left:56px;right:56px;bottom:200px;color:#fff;font-size:17px;font-weight:600;line-height:2.2">
    <div style="display:flex;align-items:center;gap:14px"><span class="goldtext">{{ icon('location_on', 24) }}</span>187 Gouws Avenue, Raslouw AH, Centurion</div>
    <div style="display:flex;align-items:center;gap:14px"><span class="goldtext">{{ icon('home', 24) }}</span>dynamicauctioneers.co.za</div>
    <div style="display:flex;align-items:center;gap:14px"><span class="goldtext">{{ icon('mail', 24) }}</span>{{ f.email }}</div>
    <div style="display:flex;align-items:center;gap:14px"><span class="goldtext">{{ icon('call', 24) }}</span>{{ f.phone | nb }}</div>
  </div>
  <div style="position:absolute;left:56px;right:56px;bottom:40px;color:#fff;font-size:9.5px;line-height:1.5;opacity:.92">
    <div style="font-weight:800;font-size:12px;letter-spacing:.06em;margin-bottom:8px" class="goldtext">PROPERTY REF: {{ ref }}</div>
    <div>All prices indicated exclude VAT. VAT will be added where applicable. Information provided as received from available records and the Seller. Neither the Agent nor the Seller warrants or guarantees the correctness of any information provided. T's &amp; C's apply.</div>
    <div style="margin-top:4px">Dynamic Solutions 1068 (Pty) Ltd t/a Dynamic Auctioneers</div>
  </div>
  <div class="goldbar" style="position:absolute;left:0;right:0;bottom:0;height:16px"></div>
</div>

<script>
(function () {
  function fit() {
    document.querySelectorAll('[data-fit]').forEach(function (el) {
      var s = parseFloat(getComputedStyle(el).fontSize), min = parseFloat(el.dataset.min || 8), i = 0;
      var oneLine = el.classList.contains('fit');
      function over() { return el.scrollWidth > el.clientWidth + 1 || (!oneLine && el.scrollHeight > el.clientHeight + 1); }
      while (over() && s > min && i < 300) { s -= 1; el.style.fontSize = s + 'px'; i++; }
    });
  }
  function json(id) { try { return JSON.parse(document.getElementById(id).textContent) || []; } catch (e) { return []; } }

  // Each photo's own shape, known before the pages are laid out.
  var ratio = {};
  function preload(srcs) {
    return Promise.all(srcs.map(function (s) {
      return new Promise(function (done) {
        var im = new Image();
        im.onload = function () { if (im.naturalWidth && im.naturalHeight) ratio[s] = im.naturalWidth / im.naturalHeight; done(); };
        im.onerror = function () { done(); };
        im.src = s;
      });
    }));
  }
  // One wide photo keeps its own landscape shape (an aerial shows the whole boundary); a
  // pair or three side by side are 4:3, a phone photo's own. Never a tall crop.
  function shape(s, n) { return n === 1 ? Math.min(1.9, Math.max(1.25, ratio[s] || 4 / 3)) : 4 / 3; }
  function photoRow(srcs) {
    var row = document.createElement('div');
    row.className = 'prow ' + ['', 'prow--wide', 'prow--pair', 'prow--trio'][srcs.length];
    srcs.forEach(function (s) {
      var d = document.createElement('div'), img = document.createElement('img');
      d.className = 'photo'; d.style.aspectRatio = shape(s, srcs.length);
      img.src = s; d.appendChild(img); row.appendChild(d);
    });
    return row;
  }
  function over(box) { return box.scrollHeight > box.clientHeight + 1; }

  // The room a page has left takes photos while they fit whole: one wide, else a pair,
  // else three small ones; anything less stays white rather than squeezing a photo.
  function fillRest(box, pool, keep) {
    for (var guard = 0; guard < 10; guard++) {
      var placed = false;
      for (var n = 1; n <= 3 && !placed; n++) {
        if (pool.length < n || pool.length - n < keep) continue;
        var row = photoRow(pool.slice(0, n));
        box.appendChild(row);
        if (over(box)) { box.removeChild(row); } else { pool.splice(0, n); placed = true; }
      }
      if (!placed) return;
    }
  }

  function layout() {
    var flow = document.getElementById('flow'), out = document.getElementById('pages'),
        shell = document.getElementById('page-shell');
    if (!flow || !out || !shell) return;
    // the contents page first, with the ad's own photos, which the pages then don't repeat
    var cover = json('contents-photos'), shown = cover.slice();
    var contents = document.querySelector('#contents-page .inner');
    if (contents) fillRest(contents, cover, 0);
    shown = shown.filter(function (s) { return cover.indexOf(s) < 0; });
    var pool = json('pack-photos');
    if (pool.length > shown.length + 8) pool = pool.filter(function (s) { return shown.indexOf(s) < 0; });
    var keep = Math.min(9, Math.ceil(pool.length / 2));      // kept back for the photo pages
    var pages = [], inner = null, sec = null, first = {}, last = {};

    function newPage() {
      var pg = shell.content.firstElementChild.cloneNode(true);
      out.appendChild(pg); pages.push(pg);
      pg.querySelector('.pno').textContent = pages.length + '.';
      inner = pg.querySelector('.inner');
    }
    function breakPage() { fillRest(inner, pool, keep); newPage(); }
    function note() { if (sec) last[sec] = pages.length; }

    flow.querySelectorAll('[data-fixed] .photo').forEach(function (d) {
      var img = d.querySelector('img'); if (img) d.style.aspectRatio = shape(img.getAttribute('src'), 1);
    });
    var blocks = [].slice.call(flow.children).map(function (b) {
      if (!b.hasAttribute('data-photos')) return b;
      var n = +b.dataset.photos;
      return pool.length - n >= keep ? photoRow(pool.splice(0, n)) : null;
    }).filter(Boolean);

    newPage();
    for (var i = 0; i < blocks.length; i++) {
      var b = blocks[i];
      if (b.hasAttribute('data-gallery')) {
        // the photo pages: the photos still unused, page by page, as they fit; three
        // stay back for the room the last page leaves
        var tail = pool.length > 9 ? 3 : 0;
        for (var guard = 0; pool.length > tail && guard < 40; guard++) {
          fillRest(inner, pool, tail); note();
          if (pool.length > tail) newPage();
        }
        continue;
      }
      var group = [b];        // a heading or divider stays with the block after it
      while (group[group.length - 1].hasAttribute('data-keep') && blocks[i + 1] && !blocks[i + 1].hasAttribute('data-gallery')) {
        group.push(blocks[++i]);
      }
      var head = group[0].getAttribute('data-sec');
      if (head === 'Photographic Overview' && inner.children.length) breakPage();
      group.forEach(function (g) { inner.appendChild(g); });
      if (over(inner) && inner.children.length > group.length) {
        group.forEach(function (g) { inner.removeChild(g); });
        breakPage();
        group.forEach(function (g) { inner.appendChild(g); });
      }
      if (head) { sec = head; first[sec] = first[sec] || pages.length; }
      note();
    }
    fillRest(inner, pool, 0);
    flow.parentNode.removeChild(flow);
    document.querySelectorAll('[data-toc]').forEach(function (el) {
      var t = el.getAttribute('data-toc'), a = first[t], z = last[t];
      el.textContent = a ? (z && z !== a ? a + '-' + z : '' + a) : '';
    });
  }

  var started = false;
  function start() {
    if (started) return;
    started = true;
    fit();
    var srcs = json('pack-photos').concat(json('contents-photos'));
    document.querySelectorAll('#flow img').forEach(function (i) { srcs.push(i.getAttribute('src')); });
    Promise.race([preload(srcs), new Promise(function (r) { setTimeout(r, 9000); })]).then(function () {
      layout();
      document.body.dataset.ready = '1';
    });
  }
  Promise.all([document.fonts.ready]).then(start);
  setTimeout(start, 6000);
})();
</script>
</body></html>
