<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<style>
{{ font_css() }}
:root{
  --gold: linear-gradient(90deg,#ac874a 0%,#ddc689 55%,#c7a560 100%);
  --goldv: linear-gradient(180deg,#fff0bf 0%,#f3d68a 38%,#dcb465 68%,#c0924a 100%);
  --goldline:#c9a45c; --ink:#0b0b0b; --orange:#ec5a24;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:{{ fmt.width }}px;height:{{ fmt.height }}px;overflow:hidden;background:#000}
body{font-family:'Montserrat',sans-serif;color:#fff;-webkit-font-smoothing:antialiased;position:relative;line-height:1.08}
.abs{position:absolute}
.bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.goldtext{background:var(--goldv);-webkit-background-clip:text;background-clip:text;color:transparent}
.glow{filter:drop-shadow(0 3px 8px rgba(0,0,0,.7))}
.goldbar{background:var(--gold);color:var(--ink)}
.fit{white-space:nowrap;overflow:hidden}
.ic{display:inline-flex;align-items:center;justify-content:center;flex:none}
.ic svg{width:100%;height:100%;display:block}
.ic.unit{border:4px solid currentColor;border-radius:4px;font-weight:800;letter-spacing:-.02em}
.ic.unit span{font-size:.42em;line-height:1}
/* The logo's words run edge to edge, so the plaque keeps a margin round them and
   only starts to narrow below them. */
.shield{background:#fff;clip-path:polygon(0 0,100% 0,100% 84%,50% 100%,0 84%);display:flex;align-items:flex-start;justify-content:center;filter:drop-shadow(0 10px 18px rgba(0,0,0,.55))}
.shield img{width:74%;margin-top:8%}
.shadow{filter:drop-shadow(0 6px 14px rgba(0,0,0,.6))}
/* A dwelling's own features, boxed, its name in gold top right (the team's DP2933 / DP2956 ads). */
.grp{border:2px solid var(--goldline);border-radius:12px;padding:6px 16px 10px;display:flex;flex-direction:column;justify-content:space-evenly;gap:4px;background:rgba(0,0,0,.25)}
.grp__t{align-self:flex-end;font-weight:800;letter-spacing:.08em;color:#e3c37a;line-height:1;margin-bottom:-4px}
.tshadow{text-shadow:0 3px 10px rgba(0,0,0,.65)}
{% block css %}{% endblock %}
</style></head>
<body>
{% block body %}{% endblock %}
<script>
(function () {
  function fit() {
    document.querySelectorAll('[data-fit]').forEach(function (el) {
      // One-line text (.fit) only has to fit across: a tight line-height makes
      // glyphs poke above and below the line box, which is not overflow. A
      // wrapping block has to fit inside its height.
      var s = parseFloat(getComputedStyle(el).fontSize), min = parseFloat(el.dataset.min || 12), i = 0;
      var oneLine = el.classList.contains('fit');
      function over() {
        return el.scrollWidth > el.clientWidth + 1 || (!oneLine && el.scrollHeight > el.clientHeight + 1);
      }
      while (over() && s > min && i < 400) { s -= 1; el.style.fontSize = s + 'px'; i++; }
    });
  }
  function done() { fit(); document.body.dataset.ready = '1'; }
  var waiting = [].slice.call(document.images).filter(function (i) { return !i.complete; })
    .map(function (i) { return new Promise(function (r) { i.onload = i.onerror = r; }); });
  Promise.all([document.fonts.ready].concat(waiting)).then(done);
  setTimeout(done, 8000);
})();
</script>
</body></html>
