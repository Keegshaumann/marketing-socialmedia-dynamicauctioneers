{% extends "_canvas.html.j2" %}
{# The auction app's tile, 1280x960 (DP3107 APP ICON.png). #}
{% block css %}
.lockup{display:flex;align-items:center;gap:6px}
.lockup .mark{width:150px;height:98px;overflow:hidden;position:relative}
.lockup .mark img{position:absolute;left:-4px;top:-6px;width:158px}
.lockup .words{display:flex;flex-direction:column;line-height:1}
{% endblock %}
{% block body %}
{% if aerial %}<img class="bg" src="{{ aerial }}" style="filter:brightness(.85)">{% endif %}
<div class="abs" style="left:0;top:0;width:1280px;height:158px;background:linear-gradient(180deg,rgba(0,0,0,.92),rgba(0,0,0,.72))"></div>
<div class="abs lockup" style="left:52px;top:20px">
  <div class="mark"><img src="{{ logo('auctioneers-on-dark') }}"></div>
  <div class="words"><span style="font-weight:800;font-size:62px;letter-spacing:.02em">DYNAMIC</span>
    <span class="goldtext" style="font-weight:600;font-size:31px;letter-spacing:.2em;margin-top:6px">AUCTIONEERS</span></div>
</div>
<div class="abs" style="right:40px;top:50px;height:56px;padding:0 26px;border:3px solid #fff;border-radius:28px;display:flex;align-items:center;font-weight:800;font-size:25px">PROPERTY REF: {{ ref }}</div>
<div class="abs goldbar" style="left:0;top:158px;width:1280px;height:8px"></div>

<div class="abs" style="left:0;top:166px;width:1280px;height:150px;background:rgba(0,0,0,.62);display:flex;flex-direction:column;align-items:center;justify-content:center">
  <div class="fit" data-fit data-min="26" style="font-weight:900;font-size:56px;max-width:1180px;width:1180px;text-align:center;height:64px">{{ (f.short_title or f.subline) | nb }}</div>
  <div style="width:960px;height:2px;background:rgba(255,255,255,.85);margin:10px 0"></div>
  <div class="fit" data-fit data-min="22" style="font-weight:800;font-size:44px;width:1180px;text-align:center;height:52px">{{ (f.short_place or f.headline) | nb }}</div>
</div>

{% for p in [photo1 if photo1 != aerial else hero, photo2] %}{% if p %}
<div class="abs" style="left:96px;top:{{ 400 + loop.index0 * 226 }}px;width:340px;height:206px;border:4px solid #c9a45c;overflow:hidden;box-shadow:0 8px 20px rgba(0,0,0,.6)"><img src="{{ p }}" style="width:100%;height:100%;object-fit:cover"></div>
{% endif %}{% endfor %}

<div class="abs" style="left:620px;top:668px;width:630px;height:196px;background:linear-gradient(180deg,rgba(0,0,0,.82),rgba(0,0,0,.92));border:3px solid #c9a45c;padding:14px 20px;display:flex;flex-direction:column;align-items:center;justify-content:space-between">
  <div data-fit data-min="12" style="font-weight:600;font-size:21px;text-align:center;height:52px;width:580px;line-height:1.2">{{ f.location_line | nb }}</div>
  <div style="display:flex;align-items:center;gap:10px;font-weight:900;font-size:33px;white-space:nowrap">
    <span>{{ f.auction_kind or 'ONLINE' }}</span>{% if f.sale_kind %}<span class="goldbar" style="padding:2px 10px">{{ f.sale_kind }}</span>{% endif %}<span>AUCTION</span>
  </div>
  <div class="fit" data-fit data-min="18" style="font-weight:800;font-size:36px;width:580px;text-align:center">{{ f.auction_date }}{% if f.auction_time %} | {{ f.auction_time }}{% endif %}</div>
</div>

<div class="abs goldbar" style="left:0;bottom:0;width:1280px;height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 44px;font-weight:800;font-size:30px">
  <span style="display:flex;align-items:center;gap:14px"><span style="width:48px;height:48px;border-radius:50%;background:#0b0b0b;color:#e9cf8a;display:flex;align-items:center;justify-content:center">{{ icon('call', 30) }}</span>{{ f.phone | nb }}</span>
  <span style="display:flex;align-items:center;gap:14px">{{ icon('mail', 46, 40) }}<span class="fit" data-fit data-min="16" style="display:block;max-width:760px">{{ f.email }}</span></span>
</div>
{% endblock %}
