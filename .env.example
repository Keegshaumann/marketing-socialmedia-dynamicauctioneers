# Copy to .env and fill in. Never commit .env (it is gitignored).
# This file is the TEMPLATE: keep it blank, no real secrets. Real values go in .env.

# --- Core (Phase 1-3): extraction, verification, copy -----------------------
ANTHROPIC_API_KEY=

# --- Platform (Phase 4) -----------------------------------------------------
# Behind HTTPS (Caddy), set to 1 so the session cookie is marked Secure.
ENGINE_HTTPS=

# --- Distribution: GoHighLevel Social Planner (Phase 5, D11) ----------------
# The pit-... token is entered in the platform Settings screen (stored in the DB),
# not here. Location + account ids can live here or in Settings.
GHL_API_TOKEN=
GHL_LOCATION_ID=
# GHL_ACCOUNT_MAP is JSON, e.g. {"facebook":"acc_id","instagram":"acc_id"}
GHL_ACCOUNT_MAP=

# --- Rendering: Canva Connect (optional, Enterprise-only, D12/D14) -----------
# Only needed if DA moves to Canva Enterprise and you set ENGINE_RENDERER=canva.
# The redirect below is entered in the Canva Developer Portal form AND used by the
# one-time authorize step; keep the two identical.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REFRESH_TOKEN=
CANVA_REDIRECT_URI=http://127.0.0.1:8080/callback
# CANVA_TEMPLATE_MAP is JSON (inline or a path to a .json file), in one of two shapes:
#   flat (one design set):   {"demo_ad":"<brand_template_id>", ...}
#   named sets (D33):        {"Classic gold":{"demo_ad":"<id>"}, "Modern dark":{"demo_ad":"<id>"}}
# With named sets the FIRST set is the default: it defines WHICH formats render
# through Canva, and later sets overlay it (a set that maps only demo_ad restyles
# the demo ad and inherits the rest; formats only a later set maps are ignored).
# When more than one set is configured AND ENGINE_RENDERER is canva/mixed with a
# working Canva config, gate 2 shows a "Design template" picker; the pick is
# stored per property on marketing.template_set (blank = follow the first set).
CANVA_TEMPLATE_MAP=

# --- Media & OneDrive watcher (Phase 5-6) -----------------------------------
META_PAGE_ACCESS_TOKEN=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# --- Auction proposals (M9, D103) --------------------------------------------
# The MS_GRAPH_* credentials above also let a proposal be saved in its property
# folder and turned into a PDF by SharePoint. The app registration needs the
# Sites.ReadWrite.All APPLICATION permission with admin consent. Without them the
# Word file is still generated. Blank means the default shown.
PROPOSAL_SHAREPOINT_HOST=        # dynamicauctioneers.sharepoint.com
PROPOSAL_SHAREPOINT_SITE=        # sites/Marketing
PROPOSAL_SHAREPOINT_FOLDER=      # 3. PROPERTIES 2026/6. AAA Properties
